''
' bu1ld0r - UI/BIN.BM
' =============================================================================
' The bin: the six shapes, and the prefabs of the folder open (its folders
' first). Click one to put it down (or drag it onto the model); a prefab
' right-clicked opens to change it. Where everything is comes from BinTile,
' BinItemRect and BinBtn, for drawing and clicks alike.
'

SUB BinSetup
    DIM k, i, ok
    ' The palette: ANSI32 (lospec.com/palette-list/ansi32 - as DRAW's ASSETS/PALETTES)
    Words "000000 0000A3 0037D1 4B4CFF 91A4F0 4CFFFF ACFFFF 00A3A3 004746 0C380C 007701 4CFF4D C5FFC5 DFDFDF CACACA A3A3A3 707070 4C4C4C 292929 773800 DC6A00 FFA300 FE4746 C20000 770000 762979 CC29CC FF4CFE FF9DFF EFBBBB FFF28C FFFFFF"
    FOR i = 0 TO NUM_PAL - 1: palCol(i) = ParseCol~&(wd$(i + 1), ok): NEXT
    HelpSetup
    FOR k = 1 TO NUM_KINDS
        binIcon&(k) = _NEWIMAGE(64, 64, 32)
        RenderIcon k, "", binIcon&(k)
    NEXT
    PfLoadAll
    BinList
END SUB

' A shape's (or prefab r$'s) picture for the bin: part 0 made that, drawn on its own
SUB RenderIcon (k, r$, img&)
    DIM sTX, sTY, sTZ, sYaw, sPitch, sDist, sOrtho, t0 AS LONG, t AS LONG, d, lo AS V3, hi AS V3, p AS V3, j, r, pass, ext
    sTX = camTX: sTY = camTY: sTZ = camTZ: sYaw = camYaw: sPitch = camPitch: sDist = camDist: sOrtho = camOrtho: camOrtho = 0
    PartFresh 0, k, 0, 0, 0
    IF k = K_USE THEN
        pRef$(0) = r$
    ELSE
        pSX(0) = 1: pSY(0) = 1: pSZ(0) = 1: pCol(0) = _RGB32(0, 200, 230)
        IF k = K_TUBE THEN pSY(0) = .5
        IF k >= K_DIE THEN ' (the newer shapes: as they're made, the biggest way 1)
            r = kindSX(k): IF kindSY(k) > r THEN r = kindSY(k)
            IF kindSZ(k) > r THEN r = kindSZ(k)
            pSX(0) = kindSX(k) / r: pSY(0) = kindSY(k) / r: pSZ(0) = kindSZ(k) / r
        END IF
        IF FitKind(k) THEN pAmt(0) = kindAmt(k): ShapeFit 0, 0, 1 ' (its own proportions)
    END IF
    t0 = tN: MeshPart 0
    camTX = 0: camTY = .45: camTZ = 0: camYaw = 35: camPitch = 24: camDist = 2.7
    IF tN > t0 AND k <> K_BOX THEN ' (a prefab: framed to fill the picture; a shape centred)
        lo.x = 1E9: lo.y = 1E9: lo.z = 1E9: hi.x = -1E9: hi.y = -1E9: hi.z = -1E9
        FOR t = t0 + 1 TO tN
            FOR j = 0 TO 2
                SELECT CASE j
                    CASE 0: p = tA(t)
                    CASE 1: p = tB(t)
                    CASE ELSE: p = tC(t)
                END SELECT
                IF p.x < lo.x THEN lo.x = p.x
                IF p.y < lo.y THEN lo.y = p.y
                IF p.z < lo.z THEN lo.z = p.z
                IF p.x > hi.x THEN hi.x = p.x
                IF p.y > hi.y THEN hi.y = p.y
                IF p.z > hi.z THEN hi.z = p.z
            NEXT
        NEXT
        camTX = (lo.x + hi.x) / 2: camTY = (lo.y + hi.y) / 2: camTZ = (lo.z + hi.z) / 2
        r = SQR((hi.x - lo.x) ^ 2 + (hi.y - lo.y) ^ 2 + (hi.z - lo.z) ^ 2) / 2: IF r < .01 THEN r = .01
        IF k = K_USE THEN camDist = r / DSin(camFov / 2) * 1.05
    END IF
    FOR pass = 1 TO 3 ' (a shape: drawn again until as big as the box's)
        CamBasis 64, 64
        LightFromCamera .45, .6
        RenderBegin img&, 64, 64
        d = _DEST: _DEST img&: CLS , _RGBA32(0, 0, 0, 0): _DEST d
        rOrtho = 0: rCull = -1: rGhost = 0
        FOR t = t0 + 1 TO tN: RasterTri t: NEXT
        RenderEnd
        IF k > NUM_KINDS THEN EXIT FOR
        ext = IconExtent(img&)
        IF k = K_BOX THEN binFill = ext: EXIT FOR
        IF ext < 1 OR binFill < 1 OR ABS(ext - binFill) <= 1 THEN EXIT FOR
        camDist = camDist * ext / binFill
    NEXT
    tN = t0
    camTX = sTX: camTY = sTY: camTZ = sTZ: camYaw = sYaw: camPitch = sPitch: camDist = sDist: camOrtho = sOrtho
    viewDirty = -1: ghostKey$ = "" ' (part 0, the ghost, was used: it's made again)
    IF ghostOn THEN GhostRemake
END SUB

' How big an icon came out: its drawn pixels' box, the longer way
FUNCTION IconExtent (img&)
    DIM x, y, x0, y0, x1, y1, s&, w
    x0 = 999: y0 = 999: x1 = -1: y1 = -1
    s& = _SOURCE: _SOURCE img&
    FOR y = 0 TO _HEIGHT(img&) - 1
        FOR x = 0 TO _WIDTH(img&) - 1
            IF _ALPHA32(POINT(x, y)) > 0 THEN
                IF x < x0 THEN x0 = x
                IF x > x1 THEN x1 = x
                IF y < y0 THEN y0 = y
                IF y > y1 THEN y1 = y
            END IF
        NEXT
    NEXT
    _SOURCE s&
    w = x1 - x0 + 1: IF y1 - y0 + 1 > w THEN w = y1 - y0 + 1
    IF x1 < 0 THEN w = 0
    IconExtent = w
END FUNCTION

' ---------------------------------------------------------------- layout

' The six shapes: 3 across, 2 down
SUB BinTile (k, x, y, w, h)
    DIM c
    c = BinShapeCols
    x = 6 + ((k - 1) MOD c) * 48: y = 50 + ((k - 1) \ c) * 50: w = 44: h = 46
END SUB

' The shapes' tiles across: as many as the bin's width holds
FUNCTION BinShapeCols
    DIM c
    c = (BIN_W - 6) \ 48: IF c < 1 THEN c = 1
    BinShapeCols = c
END FUNCTION

' Where the tabs' tiles start: under the shapes, the tabs and the path
FUNCTION BI_Y0
    BI_Y0 = 50 + ((NUM_KINDS + 2 + BinShapeCols - 1) \ BinShapeCols) * 50 + 44 ' (the shapes, the pen, text)
END FUNCTION

' The tabs' line (their names, then the path under them)
FUNCTION BinTabY
    BinTabY = BI_Y0 - 42
END FUNCTION

' Item i of the folder: 2 across from BI_Y0 (w 0: scrolled out of sight)
SUB BinItemRect (i, x, y, w, h)
    DIM row, s
    s = BinTS
    row = (i - 1) \ BinCols - binTop
    x = 6 + ((i - 1) MOD BinCols) * (s + 8): y = BI_Y0 + row * (s + 24): w = s + 2: h = s + 20
    IF row < 0 OR row >= BinRows THEN w = 0: h = 0
END SUB

' A tile's picture size: 64 for prefabs; the PICTURES tab's as Shift + wheel set it (no wider than the bin)
FUNCTION BinTS
    DIM s
    s = 64
    IF binTab = 1 THEN
        s = picTS: IF s < PIC_TS_MIN THEN s = 64
        IF s > BIN_W - 14 THEN s = BIN_W - 14
    END IF
    BinTS = s
END FUNCTION

' How many tiles across the bin is (2 at 64, wider as it's dragged wider)
FUNCTION BinCols
    DIM c
    c = (BIN_W - 6) \ (BinTS + 8): IF c < 1 THEN c = 1
    BinCols = c
END FUNCTION

' How many rows of tiles the bin shows, at our screen's height
FUNCTION BinRows
    DIM r
    r = (scrH - BAR_H - 38 - BI_Y0) \ (BinTS + 24): IF r < 1 THEN r = 1
    BinRows = r
END FUNCTION

' +FOLDER, at the bin's foot
SUB BinBtn (x, y, w, h)
    x = 6: y = scrH - BAR_H - 30: w = BIN_W - 12: h = 24
END SUB

' ---------------------------------------------------------------- the folder's list

' What's in the open folder: .. (not at the top), its folders, its prefabs - by name
SUB BinList
    DIM f$, i, a
    IF binTab = 1 THEN PicBinList: EXIT SUB
    IF binTab = 2 THEN MdlBinList: EXIT SUB
    biN = 0
    IF NOT _DIREXISTS(PfDir$ + binDir$) THEN binDir$ = ""
    IF LEN(binDir$) THEN biN = 1: biKind(1) = BI_UP: biName$(1) = "..": biRef$(1) = PfFolder$(LEFT$(binDir$, LEN(binDir$) - 1))
    a = biN + 1
    f$ = _FILES$(PfDir$ + binDir$)
    DO WHILE LEN(f$)
        IF RIGHT$(f$, 1) = "/" AND f$ <> "./" AND f$ <> "../" AND INSTR(f$, " ") = 0 AND biN < MAX_BI THEN
            biN = biN + 1: biKind(biN) = BI_DIR: biName$(biN) = LEFT$(f$, LEN(f$) - 1): biRef$(biN) = binDir$ + f$
        END IF
        f$ = _FILES$
    LOOP
    BinSort a, biN
    a = biN + 1
    FOR i = 1 TO pfN
        IF PfFolder$(pfName$(i)) = binDir$ AND biN < MAX_BI THEN
            biN = biN + 1: biKind(biN) = BI_PF: biName$(biN) = PfBase$(pfName$(i)): biRef$(biN) = pfName$(i)
        END IF
    NEXT
    BinSort a, biN
    binTop = Clamp(binTop, 0, BinMaxTop)
END SUB

' MODELS: models/'s .bld files by name, each pictured as it's wanted (BinIconsDue)
SUB MdlBinList
    DIM f$, i
    FOR i = 1 TO MAX_BI
        IF biIcon&(i) < -1 THEN _FREEIMAGE biIcon&(i)
        biIcon&(i) = 0
    NEXT
    biN = 0
    f$ = _FILES$(appDir$ + "models/")
    DO WHILE LEN(f$)
        IF LCASE$(RIGHT$(f$, 4)) = ".bld" AND RIGHT$(f$, 1) <> "/" AND biN < MAX_BI THEN
            biN = biN + 1: biKind(biN) = BI_MDL: biName$(biN) = LEFT$(f$, LEN(f$) - 4): biRef$(biN) = biName$(biN)
        END IF
        f$ = _FILES$
    LOOP
    BinSort 1, biN
    binTop = Clamp(binTop, 0, BinMaxTop)
END SUB

' A model in models/ pictured as the bin shows a prefab: its parts read in after
' the library's, a prefab for a moment ("*" + its name: no file's)
SUB ModelIcon (n$, img&)
    DIM fh, t$, n AS LONG
    IF NOT _FILEEXISTS(ModelPath$(n$)) OR pfN >= MAX_PF THEN EXIT SUB
    fh = FREEFILE: OPEN ModelPath$(n$) FOR BINARY AS #fh: t$ = SPACE$(LOF(fh)): GET #fh, , t$: CLOSE #fh
    n = PartsFromText&(t$, PF_BASE + pfTop, MAX_PFP - pfTop)
    IF n = 0 THEN EXIT SUB
    pfName$(pfN + 1) = "*" + n$: pfFirst(pfN + 1) = PF_BASE + pfTop: pfCnt(pfN + 1) = n: pfIcon&(pfN + 1) = 0
    pfN = pfN + 1
    RenderIcon K_USE, "*" + n$, img&
    pfN = pfN - 1: pfName$(pfN + 1) = ""
    MeshGcDue
END SUB

' A model clicked in MODELS (or picked in OPEN): opened - not saved, it asks first
SUB MdlBinOpen (n$)
    IF mdlDirty THEN
        askOn = -1: askArg$ = n$
        Msg "The model open isn't saved: SAVE FIRST, OPEN ANYWAY (its changes lost), or CANCEL"
        EXIT SUB
    END IF
    ModelLoad n$
END SUB

' The question asked when a model would be opened over unsaved work: a box in the view
SUB AskRect (k, x, y, w, h)
    x = vX0 + (vW - 420) \ 2: y = vY0 + vH \ 3: w = 420: h = 110
    IF k THEN y = y + 70: h = 26: w = 128: x = x + 10 + (k - 1) * 134 ' (1 SAVE FIRST, 2 OPEN ANYWAY, 3 CANCEL)
END SUB

SUB AskDraw
    DIM x, y, w, h, k
    AskRect 0, x, y, w, h
    LINE (x, y)-(x + w - 1, y + h - 1), _RGBA32(12, 10, 22, 245), BF
    LINE (x, y)-(x + w - 1, y + h - 1), cWarn, B
    Txt x + 12, y + 12, "OPEN " + UCASE$(askArg$) + "?", cHi
    Txt x + 12, y + 34, "What's open now isn't saved (" + mdlName$ + ").", cText
    FOR k = 1 TO 3
        AskRect k, x, y, w, h
        Btn x, y, w, h, AskName$(k), 0
    NEXT
END SUB

FUNCTION AskName$ (k)
    SELECT CASE k
        CASE 1: AskName$ = "SAVE FIRST"
        CASE 2: AskName$ = "OPEN ANYWAY"
        CASE ELSE: AskName$ = "CANCEL"
    END SELECT
END FUNCTION

SUB AskFrame
    DIM x, y, w, h, k
    IF NOT mP1 THEN EXIT SUB
    FOR k = 1 TO 3
        AskRect k, x, y, w, h
        IF InRect(mX, mY, x, y, w, h) THEN AskAnswer k: EXIT SUB
    NEXT
    AskRect 0, x, y, w, h
    IF NOT InRect(mX, mY, x, y, w, h) THEN AskAnswer 3
END SUB

' 1 save, then open; 2 open; 3 neither (Esc)
SUB AskAnswer (k)
    askOn = 0
    SELECT CASE k
        CASE 1
            ModelSave
            IF mdlDirty THEN Msg "Not saved - " + askArg$ + " not opened": EXIT SUB
            ModelLoad askArg$
        CASE 2: ModelLoad askArg$
        CASE ELSE: Msg "Not opened"
    END SELECT
END SUB

' A model dragged from MODELS into the view: put down whole (its parts read in as
' a prefab for now, "*NAME", so the ghost shows it), then made the model's own
' parts, one group - nothing open is lost
SUB MdlPlaceStart (n$)
    DIM fh, t$, n AS LONG
    MdlPlaceEnd
    IF NOT _FILEEXISTS(ModelPath$(n$)) OR pfN >= MAX_PF THEN EXIT SUB
    fh = FREEFILE: OPEN ModelPath$(n$) FOR BINARY AS #fh: t$ = SPACE$(LOF(fh)): GET #fh, , t$: CLOSE #fh
    n = PartsFromText&(t$, PF_BASE + pfTop, MAX_PFP - pfTop)
    IF n = 0 THEN Msg n$ + " has no parts": EXIT SUB
    mdlTmpPf = pfN + 1: mdlTmpTop = pfTop
    pfName$(mdlTmpPf) = "*" + n$: pfFirst(mdlTmpPf) = PF_BASE + pfTop: pfCnt(mdlTmpPf) = n: pfIcon&(mdlTmpPf) = 0
    pfN = mdlTmpPf: pfTop = pfTop + n
    PlaceStart K_USE, "*" + n$
    Msg "Let go where " + n$ + " goes: its parts join this model (one group - G: ungroup). Esc: not now"
END SUB

' The model being put down let go of (placing ended)
SUB MdlPlaceEnd
    IF mdlTmpPf = 0 THEN EXIT SUB
    IF pfN = mdlTmpPf THEN pfName$(pfN) = "": pfN = pfN - 1: pfTop = mdlTmpTop
    mdlTmpPf = 0: MeshGcDue
END SUB

SUB BinSort (a, b)
    DIM i, j, t$, k
    FOR i = a + 1 TO b
        j = i
        DO WHILE j > a
            IF LCASE$(biName$(j - 1)) <= LCASE$(biName$(j)) THEN EXIT DO
            SWAP biName$(j - 1), biName$(j): SWAP biRef$(j - 1), biRef$(j): SWAP biKind(j - 1), biKind(j): SWAP biIcon&(j - 1), biIcon&(j)
            j = j - 1
        LOOP
    NEXT
END SUB

FUNCTION BinMaxTop
    DIM m
    m = (biN + BinCols - 1) \ BinCols - BinRows: IF m < 0 THEN m = 0
    BinMaxTop = m
END FUNCTION

FUNCTION BinItemAt (x, y)
    DIM i, ix, iy, iw, ih
    FOR i = 1 TO biN
        BinItemRect i, ix, iy, iw, ih
        IF iw > 0 AND InRect(x, y, ix, iy, iw, ih) THEN BinItemAt = i: EXIT FUNCTION
    NEXT
END FUNCTION

' ---------------------------------------------------------------- clicks

SUB BinClick
    DIM k, x, y, w, h, i
    FOR k = 1 TO NUM_KINDS
        BinTile k, x, y, w, h
        IF InRect(mX, mY, x, y, w, h) THEN
            IF penOn THEN PenStop
            IF txOn THEN TxStop
            IF placeKind = k THEN PlaceStop ELSE PlaceStart k, ""
            EXIT SUB
        END IF
    NEXT
    BinTile NUM_KINDS + 1, x, y, w, h ' (the pen)
    IF InRect(mX, mY, x, y, w, h) THEN PenToggle: EXIT SUB
    BinTile NUM_KINDS + 2, x, y, w, h ' (text)
    IF InRect(mX, mY, x, y, w, h) THEN TxToggle: EXIT SUB
    IF mY >= BinTabY AND mY < BinTabY + 18 THEN ' (the tabs: PREFABS, PICTURES, MODELS)
        k = 0: IF mX >= 70 THEN k = 1
        IF mX >= 142 THEN k = 2
        IF k <> binTab THEN binTab = k: binTop = 0: BinList
        IF binTab = 2 THEN Msg "Models: your models in models/ - click one to open it (SAVE puts the model open here)"
        IF binTab = 1 THEN Msg "Pictures: drag one onto a face, or click it then click faces. The path under the tabs: click it to go to any folder (paste one: Ctrl+V). Right-click a picture: EDIT IN DRAW, kaleidotron. Shift + wheel: bigger or smaller"
        EXIT SUB
    END IF
    BinBtn x, y, w, h
    IF InRect(mX, mY, x, y, w, h) AND binTab <> 2 THEN
        IF binTab = 1 AND LEN(binPicExt$) > 0 THEN Msg "Back in PICTURES first: + FOLDER makes one in pictures/": EXIT SUB
        TypeStart F_DIR, "", -1
        Msg "The new folder's name (in " + IIFS$(binTab = 1, "pictures/" + binPicDir$, "prefabs/" + binDir$) + "), then Enter. Esc: not now"
        EXIT SUB
    END IF
    i = BinItemAt(mX, mY): IF i = 0 THEN EXIT SUB
    IF binTab = 2 THEN ' (let go on it: opened; dragged into the view: put in this model)
        IF biKind(i) = BI_MDL THEN mdlPress$ = biRef$(i): mdlPressI = i
        EXIT SUB
    END IF
    IF binTab = 1 THEN
        SELECT CASE biKind(i)
            CASE BI_UP, BI_DIR: PicFolderOpen biRef$(i)
            CASE BI_PIC: PicPick biRef$(i)
        END SELECT
        EXIT SUB
    END IF
    SELECT CASE biKind(i)
        CASE BI_UP, BI_DIR
            binDir$ = biRef$(i): binTop = 0: BinList
            Msg "prefabs/" + binDir$ + " - PREFAB (Ctrl+Shift+S) saves the model in here"
        CASE BI_PF
            IF placeKind = K_USE AND placeRef$ = biRef$(i) THEN PlaceStop: EXIT SUB
            IF PfLoops(biRef$(i)) THEN Msg biRef$(i) + " is (or holds) the prefab open: it can't go in itself": EXIT SUB
            PlaceStart K_USE, biRef$(i)
    END SELECT
END SUB

' Right-click a prefab: its menu - EDIT IT, RENAME / MOVE. A picture: EDIT IN DRAW,
' OPEN IN KALEIDOTRON; a pictures folder (or the empty bin: the one open): OPEN, KALEIDOTRON
SUB BinRightClick
    DIM i, x, y, w, h
    i = BinItemAt(mX, mY)
    IF binTab = 1 THEN
        IF i = 0 THEN
            IF mY < BI_Y0 THEN EXIT SUB
            binMenuKind = 2: binMenuRef$ = "" ' (the folder open)
        ELSEIF biKind(i) = BI_PIC THEN
            binMenuKind = 1: binMenuRef$ = biRef$(i)
        ELSE
            binMenuKind = 2: binMenuRef$ = biRef$(i)
            IF LEFT$(binMenuRef$, 1) <> "/" THEN binMenuRef$ = "=" + binMenuRef$ ' (one in pictures/: "=" + its folder there)
        END IF
    ELSE
        IF i = 0 THEN EXIT SUB
        IF biKind(i) <> BI_PF THEN EXIT SUB
        binMenuKind = 0: binMenuRef$ = biRef$(i)
    END IF
    binMenu = -1: binMenuX = mX: binMenuY = mY
    BinMenuRect 0, x, y, w, h ' (kept on the screen)
END SUB

' The folder a pictures folder menu is for, from / (ending in /)
FUNCTION BinMenuFolder$
    DIM r$
    r$ = binMenuRef$
    IF LEFT$(r$, 1) = "=" THEN BinMenuFolder$ = AbsPath$(PicDir$ + MID$(r$, 2)): EXIT FUNCTION
    IF LEN(r$) = 0 THEN
        IF LEN(binPicExt$) THEN BinMenuFolder$ = binPicExt$ ELSE BinMenuFolder$ = AbsPath$(PicDir$ + binPicDir$)
        EXIT FUNCTION
    END IF
    BinMenuFolder$ = r$
END FUNCTION

FUNCTION BinMenuItems
    BinMenuItems = 2: IF binMenuKind = 2 AND LEN(binMenuRef$) = 0 THEN BinMenuItems = 1
    IF binMenuKind = 1 THEN BinMenuItems = 3
END FUNCTION

FUNCTION BinMenuItem$ (k)
    SELECT CASE binMenuKind
        CASE 0: BinMenuItem$ = IIFS$(k = 1, "EDIT IT", "RENAME / MOVE")
        CASE 1: BinMenuItem$ = IIFS$(k = 1, "PAINT IT", IIFS$(k = 2, "EDIT IN DRAW", "OPEN IN KALEIDOTRON"))
        CASE 2
            IF BinMenuItems = 1 THEN BinMenuItem$ = "OPEN IN KALEIDOTRON" ELSE BinMenuItem$ = IIFS$(k = 1, "OPEN", "OPEN IN KALEIDOTRON")
    END SELECT
END FUNCTION

FUNCTION BinMenuTitle$
    DIM t$
    SELECT CASE binMenuKind
        CASE 0: t$ = PfBase$(binMenuRef$)
        CASE 1: t$ = MID$(binMenuRef$, _INSTRREV(binMenuRef$, "/") + 1): IF LEFT$(binMenuRef$, 1) <> "/" THEN t$ = t$ + ".png"
        CASE 2: t$ = Tilde$(PathClean$(BinMenuFolder$))
    END SELECT
    IF LEN(t$) > 22 THEN t$ = ".." + RIGHT$(t$, 20)
    BinMenuTitle$ = t$
END FUNCTION

SUB BinMenuRect (k, x, y, w, h)
    w = IIF(binMenuKind = 0, 170, 196)
    IF binMenuX + w > scrW - 4 THEN binMenuX = scrW - 4 - w
    IF binMenuY + 22 * (BinMenuItems + 1) + 4 > scrH - BAR_H THEN binMenuY = scrH - BAR_H - 22 * (BinMenuItems + 1) - 4
    x = binMenuX: y = binMenuY + 22 + (k - 1) * 22: h = 22
    IF k = 0 THEN y = binMenuY: h = 22 * (BinMenuItems + 1) + 4 ' (the whole of it)
END SUB

SUB BinMenuDraw
    DIM x, y, w, h, k
    BinMenuRect 0, x, y, w, h
    LINE (x, y)-(x + w - 1, y + h - 1), _RGB32(12, 10, 22), BF
    LINE (x, y)-(x + w - 1, y + h - 1), cHi, B
    Txt x + 6, y + 3, BinMenuTitle$, cDim
    FOR k = 1 TO BinMenuItems
        BinMenuRect k, x, y, w, h
        IF InRect(mX, mY, x, y, w, h) THEN LINE (x + 2, y)-(x + w - 3, y + h - 1), cHover, BF
        Txt x + 8, y + 3, BinMenuItem$(k), cText
    NEXT
END SUB

SUB BinMenuClick
    DIM x, y, w, h, k, hit
    binMenu = 0
    FOR k = 1 TO BinMenuItems
        BinMenuRect k, x, y, w, h
        IF InRect(mX, mY, x, y, w, h) THEN hit = k
    NEXT
    IF hit = 0 THEN EXIT SUB
    IF binMenuKind = 1 THEN
        SELECT CASE hit
            CASE 1: PntOpen binMenuRef$
            CASE 2: PicDrawFromBin binMenuRef$
            CASE ELSE: KaleidoOpen PicPath$(binMenuRef$)
        END SELECT
        EXIT SUB
    END IF
    IF binMenuKind = 2 THEN
        IF BinMenuItem$(hit) = "OPEN" THEN
            IF LEFT$(binMenuRef$, 1) = "=" THEN PicFolderOpen MID$(binMenuRef$, 2) ELSE PicFolderOpen binMenuRef$
        ELSE
            KaleidoOpen BinMenuFolder$
        END IF
        EXIT SUB
    END IF
    IF hit = 1 THEN PfEdit binMenuRef$: EXIT SUB
    BinMenuRect 2, x, y, w, h
    IF InRect(mX, mY, x, y, w, h) THEN
        IF typeField THEN FieldCommit
        TypeStart F_PFNAME, binMenuRef$, 0
        Msg "Its new name, then Enter (a folder in it moves it: panels/" + PfBase$(binMenuRef$) + "). Every model and prefab that uses it follows. Esc: not now"
    END IF
END SUB

SUB BinWheel
    binTop = Clamp(binTop + SGN(mWheel), 0, BinMaxTop)
END SUB

' Shift + wheel over the PICTURES tab: its tiles bigger (up) or smaller, the first one showing kept in sight
SUB PicTileWheel (d)
    DIM s, first, i
    STATIC steps(7)
    IF steps(1) = 0 THEN steps(1) = 40: steps(2) = 48: steps(3) = 64: steps(4) = 96: steps(5) = 128: steps(6) = 192: steps(7) = 256
    s = BinTS: first = binTop * BinCols
    IF d < 0 THEN ' (up: bigger)
        FOR i = 1 TO 7
            IF steps(i) > s THEN picTS = steps(i): EXIT FOR
        NEXT
    ELSE
        FOR i = 7 TO 1 STEP -1
            IF steps(i) < s THEN picTS = steps(i): EXIT FOR
        NEXT
    END IF
    IF picTS > BIN_W - 14 THEN picTS = BIN_W - 14 ' (as big as the bin is wide: drag its edge for bigger)
    IF picTS < PIC_TS_MIN THEN picTS = PIC_TS_MIN
    IF BinTS = s THEN EXIT SUB
    binTop = Clamp(first \ BinCols, 0, BinMaxTop)
    CfgSet "pic_size", LTRIM$(STR$(picTS))
    Msg "Pictures shown at" + STR$(BinTS) + " pixels (Shift + wheel)"
END SUB

' A shape (or prefab r$) to put down: the ghost follows the pointer
SUB PlaceStart (k, r$)
    pmRef$ = ""
    placeKind = k: placeRef$ = r$: placeDrag = -1: ghostKey$ = "": SelNone: ovDirty = -1
    PartFresh P_TPL, k, 0, 0, 0: pRef$(P_TPL) = r$ ' (set up as the last one of its kind was - the panel changes it)
    IF FitKind(k) THEN ShapeFit P_TPL, snapStep, kindB(k) ' (a die, star, spike: its own proportions, on the grid, as big as the last)
    gHave = 0: IF ghostOn THEN ghostOn = 0: meshDirty = -1
    IF k = K_USE THEN
        Msg "Click where " + PfBase$(r$) + " goes (or drag it there): it stands on the face you point at. Shift: keep putting them down. Esc: stop"
    ELSE
        Msg "Click where the " + kindName$(k) + " goes: it stands on the face you point at. The panel sets it up first (C: a hole). Shift: keep putting them down. Esc: stop"
    END IF
END SUB

SUB PlaceStop
    placeKind = 0: placeRef$ = "": ghostKey$ = "": gHave = 0
    IF ghostOn THEN ghostOn = 0: meshDirty = -1
    MdlPlaceEnd
END SUB

' The pictures of the folder's prefabs that aren't made yet (before the view's drawn: RenderBegin overwrites rId)
SUB BinIconsDue
    DIM i, pf, x, y, w, h
    FOR i = 1 TO biN
        IF biKind(i) = BI_MDL AND biIcon&(i) = 0 THEN ' (a model's: one a frame - it's read in to be drawn)
            BinItemRect i, x, y, w, h
            IF w > 0 THEN biIcon&(i) = _NEWIMAGE(64, 64, 32): ModelIcon biRef$(i), biIcon&(i): viewDirty = -1: EXIT SUB
        END IF
        IF biKind(i) = BI_PF THEN
            BinItemRect i, x, y, w, h
            IF w > 0 THEN
                pf = PfFind(biRef$(i))
                IF pf > 0 THEN
                    IF pfIcon&(pf) = 0 THEN pfIcon&(pf) = _NEWIMAGE(64, 64, 32): RenderIcon K_USE, pfName$(pf), pfIcon&(pf)
                END IF
            END IF
        END IF
    NEXT
END SUB

' ---------------------------------------------------------------- drawing

SUB BinDraw
    DIM k, x, y, w, h, i, pf, c AS _UNSIGNED LONG, t$, hov$, isOn, img&
    LINE (0, TOP_H)-(BIN_W - 1, scrH - BAR_H - 1), cPanel, BF
    LINE (BIN_W - 1, TOP_H)-(BIN_W - 1, scrH - BAR_H - 1), cLine
    t$ = "SHAPES"
    FOR k = 1 TO NUM_KINDS
        BinTile k, x, y, w, h
        c = cBtn: IF InRect(mX, mY, x, y, w, h) THEN c = cHover: t$ = UCASE$(kindName$(k))
        IF placeKind = k THEN c = _RGB32(90, 30, 110)
        LINE (x, y)-(x + w - 1, y + h - 1), c, BF
        LINE (x, y)-(x + w - 1, y + h - 1), cLine, B
        _PUTIMAGE (x + 2, y + 4)-(x + 41, y + 43), binIcon&(k)
        IF k <= 6 THEN Txt x + 3, y + 1, LTRIM$(STR$(k)), cDim ' (its key)
    NEXT
    BinTile NUM_KINDS + 1, x, y, w, h ' (the pen: a curve through three points)
    c = cBtn: IF InRect(mX, mY, x, y, w, h) THEN c = cHover: t$ = "PEN (P): DRAW A SHAPE"
    IF penOn THEN c = _RGB32(90, 30, 110)
    LINE (x, y)-(x + w - 1, y + h - 1), c, BF
    LINE (x, y)-(x + w - 1, y + h - 1), cLine, B
    PenIcon x, y
    Txt x + 3, y + 1, "P", cDim
    BinTile NUM_KINDS + 2, x, y, w, h ' (text: letters in a font)
    c = cBtn: IF InRect(mX, mY, x, y, w, h) THEN c = cHover: t$ = "TEXT (X): LETTERS IN A FONT"
    IF txOn THEN c = _RGB32(90, 30, 110)
    LINE (x, y)-(x + w - 1, y + h - 1), c, BF
    LINE (x, y)-(x + w - 1, y + h - 1), cLine, B
    TxIcon x, y
    Txt x + 3, y + 1, "X", cDim
    Txt 10, TOP_H + 4, t$, cHi

    y = BinTabY
    Txt 10, y + 4, "PREFABS", IIFC~&(binTab = 0, cHi, cDim)
    Txt 74, y + 4, "PICTURES", IIFC~&(binTab = 1, cHi, cDim)
    Txt 146, y + 4, "MODELS", IIFC~&(binTab = 2, cHi, cDim)
    x = 10: w = 56
    IF binTab = 1 THEN x = 74: w = 64
    IF binTab = 2 THEN x = 146: w = 48
    LINE (x, y + 17)-(x + w - 1, y + 17), cHi
    IF binTab = 1 THEN
        FieldDraw F_PICPATH
    ELSEIF binTab = 2 THEN
        Txt 10, y + 22, "/models", cDim
    ELSE
        t$ = "/" + binDir$: IF LEN(t$) > 17 THEN t$ = ".." + RIGHT$(t$, 15)
        Txt 10, y + 22, t$, cDim
    END IF
    xtLoads = 0
    FOR i = 1 TO biN
        BinItemRect i, x, y, w, h
        IF w > 0 THEN
            isOn = (biKind(i) = BI_MDL AND biRef$(i) = mdlName$ AND LEN(mdlPf$) = 0) OR (biKind(i) = BI_PF AND placeKind = K_USE AND placeRef$ = biRef$(i)) OR (biKind(i) = BI_PIC AND LEN(pmRef$) > 0 AND (pmRef$ = biRef$(i) OR pmSrc$ = biRef$(i)))
            c = cBtn: IF InRect(mX, mY, x, y, w, h) THEN c = cHover: hov$ = biName$(i)
            IF isOn THEN c = _RGB32(90, 30, 110)
            LINE (x, y)-(x + w - 1, y + h - 1), c, BF
            LINE (x, y)-(x + w - 1, y + h - 1), cLine, B
            SELECT CASE biKind(i)
                CASE BI_UP, BI_DIR
                    FolderGlyph x + (w - 40) \ 2, y + (h - 56) \ 2 + 1, biKind(i) = BI_UP
                CASE BI_PIC
                    img& = PicThumb&(biRef$(i))
                    IF img& < -1 THEN _PUTIMAGE (x + 1, y + 2), img&
                CASE BI_MDL
                    IF biIcon&(i) < -1 THEN _PUTIMAGE (x + 1, y + 2), biIcon&(i)
                CASE BI_PF
                    pf = PfFind(biRef$(i))
                    IF pf > 0 THEN
                        IF pfIcon&(pf) < -1 THEN _PUTIMAGE (x + 1, y + 2), pfIcon&(pf)
                    END IF
            END SELECT
            t$ = LEFT$(biName$(i), (w - 2) \ 8): Txt x + (w - 8 * LEN(t$)) \ 2, y + h - 17, t$, IIFC~&(biKind(i) = BI_PF OR biKind(i) = BI_PIC OR biKind(i) = BI_MDL, cText, cWarn)
        END IF
    NEXT
    IF binTab = 1 AND (biN = 0 OR (biN = 1 AND biKind(1) = BI_UP)) THEN
        Txt 10, BI_Y0 + IIF(biN, 92, 4), "None here yet:", cDim
        Txt 10, BI_Y0 + IIF(biN, 108, 20), "drop a PNG from", cDim
        Txt 10, BI_Y0 + IIF(biN, 124, 36), "your desktop on", cDim
        Txt 10, BI_Y0 + IIF(biN, 140, 52), "the window.", cDim
    ELSEIF binTab = 2 AND biN = 0 THEN
        Txt 10, BI_Y0 + 4, "None here yet:", cDim
        Txt 10, BI_Y0 + 20, "SAVE puts the", cDim
        Txt 10, BI_Y0 + 36, "model here.", cDim
    ELSEIF biN = 0 OR (biN = 1 AND biKind(1) = BI_UP) THEN
        Txt 10, BI_Y0 + IIF(biN, 92, 4), "None here yet:", cDim
        Txt 10, BI_Y0 + IIF(biN, 108, 20), "PREFAB at the top", cDim
        Txt 10, BI_Y0 + IIF(biN, 124, 36), "saves the model", cDim
        Txt 10, BI_Y0 + IIF(biN, 140, 52), "as one.", cDim
    END IF
    IF binTop < BinMaxTop THEN Txt 10, BI_Y0 + BinRows * (BinTS + 24) - 2, "more: the wheel", cDim
    IF typeField = F_DIR THEN
        FieldDraw F_DIR
    ELSEIF typeField = F_PFNAME THEN
        FieldDraw F_PFNAME
    ELSEIF binTab <> 2 THEN
        BinBtn x, y, w, h: Btn x, y, w, h, "+ FOLDER", 0
    END IF
    ' (a name too long for its tile, in full by the pointer)
    IF LEN(hov$) > (BinTS \ 8) THEN
        w = 8 * LEN(hov$) + 8
        LINE (mX + 14, mY + 4)-(mX + 14 + w, mY + 24), _RGB32(12, 10, 22), BF
        LINE (mX + 14, mY + 4)-(mX + 14 + w, mY + 24), cHi, B
        Txt mX + 18, mY + 6, hov$, cText
    END IF
END SUB

' A folder (up: with an arrow), 40 x 40 at x, y
SUB FolderGlyph (x, y, up)
    DIM c AS _UNSIGNED LONG
    c = _RGB32(200, 150, 60)
    LINE (x, y + 4)-(x + 16, y + 10), c, BF
    LINE (x, y + 10)-(x + 40, y + 40), c, BF
    LINE (x, y + 10)-(x + 40, y + 40), _RGB32(120, 80, 30), B
    IF up THEN
        LINE (x + 20, y + 16)-(x + 20, y + 34), cBg
        LINE (x + 20, y + 16)-(x + 13, y + 24), cBg
        LINE (x + 20, y + 16)-(x + 27, y + 24), cBg
    END IF
END SUB

' The pen tile's picture: a closed outline, one side curved, its points and a handle
SUB PenIcon (x, y)
    DIM k, t#, m#, px, py, qx, qy, c AS _UNSIGNED LONG
    c = _RGB32(80, 220, 230)
    LINE (x + 10, y + 36)-(x + 34, y + 36), c: LINE (x + 34, y + 36)-(x + 34, y + 22), c
    px = x + 34: py = y + 22
    FOR k = 1 TO 12 ' (a curve from (34, 22) over to (10, 36), pulled up by (30, 4) and (8, 10))
        t# = k / 12: m# = 1 - t#
        qx = m# ^ 3 * (x + 34) + 3 * m# * m# * t# * (x + 30) + 3 * m# * t# * t# * (x + 4) + t# ^ 3 * (x + 10)
        qy = m# ^ 3 * (y + 22) + 3 * m# * m# * t# * (y + 4) + 3 * m# * t# * t# * (y + 10) + t# ^ 3 * (y + 36)
        LINE (px, py)-(qx, qy), c: px = qx: py = qy
    NEXT
    LINE (x + 34, y + 22)-(x + 30, y + 6), _RGB32(60, 180, 255): LINE (x + 29, y + 5)-(x + 31, y + 7), _RGB32(60, 180, 255), BF
    LINE (x + 9, y + 35)-(x + 11, y + 37), _RGB32(240, 240, 250), BF
    LINE (x + 33, y + 35)-(x + 35, y + 37), _RGB32(240, 240, 250), BF
    LINE (x + 33, y + 21)-(x + 35, y + 23), _RGB32(240, 240, 250), BF
END SUB
