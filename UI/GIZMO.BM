''
' bu1ld0r - UI/GIZMO.BM
' =============================================================================

' A world point on our screen (ok 0: behind the eye)
SUB ScrPt (x, y, z, sx, sy, ok)
    DIM vx, vy, vz
    CamSpace x, y, z, vx, vy, vz
    ok = 0: IF vz <= .01 THEN EXIT SUB
    sx = vX0 + cMidX + vx / vz * cFoc: sy = vY0 + cMidY - vy / vz * cFoc: ok = -1
END SUB

SUB AxisVec (a, x, y, z)
    x = -(a = 1): y = -(a = 2): z = -(a = 3)
END SUB

FUNCTION AxisCol~& (a, bright)
    DIM k
    k = IIF(bright, 1, .75)
    SELECT CASE a
        CASE 1: AxisCol~& = _RGB32(240 * k, 70 * k, 80 * k)
        CASE 2: AxisCol~& = _RGB32(100 * k, 225 * k, 90 * k)
        CASE ELSE: AxisCol~& = _RGB32(80 * k, 140 * k, 255 * k)
    END SELECT
END FUNCTION

FUNCTION GzShown
    IF placeKind OR LEN(pmRef$) > 0 OR orbitOn OR panOn THEN EXIT FUNCTION
    IF edPart THEN
        EdBox: GzShown = (edCnt > 0)
    ELSE
        GzShown = (SelCount > 0)
    END IF
END FUNCTION

' Each frame: where the widget is, and which arrow is under the pointer
SUB GzUpdate
    DIM t AS LONG, p, k, lo AS V3, hi AS V3, v AS V3, vx, vy, vz, seen
    gzOk = 0: gzHover = 0
    IF NOT GzShown THEN EXIT SUB
    IF edPart THEN
        lo = edLo: hi = edHi
    ELSE
        lo.x = 1E+30: lo.y = 1E+30: lo.z = 1E+30: hi.x = -1E+30: hi.y = -1E+30: hi.z = -1E+30
        FOR t = 1 TO holeTN
            p = tPart(t)
            IF p >= 1 AND p <= pN THEN
                IF pSel(p) THEN
                    seen = -1
                    FOR k = 0 TO 2
                        SELECT CASE k
                            CASE 0: v = tA(t)
                            CASE 1: v = tB(t)
                            CASE ELSE: v = tC(t)
                        END SELECT
                        IF v.x < lo.x THEN lo.x = v.x
                        IF v.y < lo.y THEN lo.y = v.y
                        IF v.z < lo.z THEN lo.z = v.z
                        IF v.x > hi.x THEN hi.x = v.x
                        IF v.y > hi.y THEN hi.y = v.y
                        IF v.z > hi.z THEN hi.z = v.z
                    NEXT
                END IF
            END IF
        NEXT
        IF NOT seen THEN EXIT SUB
    END IF
    IF PivKey$ <> tfPivKey$ THEN tfPivOn = 0 ' (another selection: its middle again)
    IF tfPivOn AND NOT ((dragOn OR edDrag) AND tfMode <> 0) THEN ' (moved whole - same size, somewhere else: the pivot goes with it)
        IF ABS((hi.x - lo.x) - (gzHi.x - gzLo.x)) + ABS((hi.y - lo.y) - (gzHi.y - gzLo.y)) + ABS((hi.z - lo.z) - (gzHi.z - gzLo.z)) < .000001 THEN
            tfPiv.x = tfPiv.x + lo.x - gzLo.x: tfPiv.y = tfPiv.y + lo.y - gzLo.y: tfPiv.z = tfPiv.z + lo.z - gzLo.z
        END IF
    END IF
    gzLo = lo: gzHi = hi
    gzC.x = (lo.x + hi.x) / 2: gzC.y = (lo.y + hi.y) / 2: gzC.z = (lo.z + hi.z) / 2
    IF tfPivOn THEN gzC = tfPiv
    CamSpace gzC.x, gzC.y, gzC.z, vx, vy, vz
    IF vz <= .05 THEN EXIT SUB
    gzL = 64 * vz / cFoc: gzOk = -1
    IF InRect(mX, mY, vX0, vY0, vW, vH) AND NOT dragOn AND NOT edDrag THEN gzHover = GzHit(mX, mY)
END SUB

' The arrow (1-3) the screen point (x, y) is on: 0 none
FUNCTION GzHit (x, y)
    DIM a, ax, ay, az, sx0, sy0, sx1, sy1, ok, ok2, dx, dy, l, s, d, best
    best = 8
    ScrPt gzC.x, gzC.y, gzC.z, sx0, sy0, ok: IF ok = 0 THEN EXIT FUNCTION
    FOR a = 1 TO 3
        AxisVec a, ax, ay, az
        ScrPt gzC.x + ax * gzL, gzC.y + ay * gzL, gzC.z + az * gzL, sx1, sy1, ok2
        IF ok2 AND tfAx(a) <> 0 THEN
            dx = sx1 - sx0: dy = sy1 - sy0: l = SQR(dx * dx + dy * dy)
            IF l > 6 THEN
                s = ((x - sx0) * dx + (y - sy0) * dy) / (l * l)
                IF s > .2 AND s < 1.15 THEN
                    d = ABS((x - sx0) * dy - (y - sy0) * dx) / l
                    IF d < best THEN best = d: GzHit = a
                END IF
            END IF
        END IF
    NEXT
END FUNCTION

SUB GzDraw
    DIM a, ax, ay, az, sx0, sy0, sx1, sy1, ok, ok2, c AS _UNSIGNED LONG, k, dx, dy, l, px, py, hot
    IF dragAxis THEN AxisGuide dragAxis
    IF NOT gzOk THEN EXIT SUB
    IF dragOn OR edDrag THEN EXIT SUB
    ScrPt gzC.x, gzC.y, gzC.z, sx0, sy0, ok: IF ok = 0 THEN EXIT SUB
    FOR a = 1 TO 3
        AxisVec a, ax, ay, az
        ScrPt gzC.x + ax * gzL, gzC.y + ay * gzL, gzC.z + az * gzL, sx1, sy1, ok2
        IF ok2 AND tfAx(a) <> 0 THEN ' (only the axes TRANSFORM has on)
            hot = (gzHover = a)
            c = AxisCol~&(a, hot)
            dx = sx1 - sx0: dy = sy1 - sy0: l = SQR(dx * dx + dy * dy)
            IF l > 6 THEN
                px = -dy / l: py = dx / l
                FOR k = -2 TO 2 ' (a dark edge: it shows on any colour)
                    LINE (sx0 + px * k, sy0 + py * k)-(sx1 + px * k, sy1 + py * k), _RGB32(10, 8, 18)
                NEXT
                FOR k = -1 TO 1
                    LINE (sx0 + px * k, sy0 + py * k)-(sx1 + px * k, sy1 + py * k), c
                NEXT
                SELECT CASE tfMode ' (the head: MOVE a little triangle, SCALE a square, TURN a ring)
                    CASE 1
                        LINE (sx1 + dx / l * 4 - 4, sy1 + dy / l * 4 - 4)-(sx1 + dx / l * 4 + 4, sy1 + dy / l * 4 + 4), c, BF
                    CASE 2
                        CIRCLE (sx1 + dx / l * 5, sy1 + dy / l * 5), 5, c: CIRCLE (sx1 + dx / l * 5, sy1 + dy / l * 5), 4, c
                    CASE ELSE
                        LINE (sx1 + dx / l * 9, sy1 + dy / l * 9)-(sx1 + px * 5, sy1 + py * 5), c
                        LINE (sx1 + dx / l * 9, sy1 + dy / l * 9)-(sx1 - px * 5, sy1 - py * 5), c
                        LINE (sx1 + px * 5, sy1 + py * 5)-(sx1 - px * 5, sy1 - py * 5), c
                END SELECT
                Txt sx1 + dx / l * 12 - 4, sy1 + dy / l * 12 - 8, MID$("XYZ", a, 1), c
            END IF
        END IF
    NEXT
    LINE (sx0 - 2, sy0 - 2)-(sx0 + 2, sy0 + 2), _RGB32(230, 230, 240), BF
END SUB

' The axis a drag keeps to, through what's moving: long, with a tick at each snap step
SUB AxisGuide (a)
    DIM ax, ay, az, sx0, sy0, sx1, sy1, ok, ok2, c AS _UNSIGNED LONG, st, i, n, dx, dy, l, px, py, x, y, z
    IF NOT gzOk THEN EXIT SUB
    AxisVec a, ax, ay, az
    c = AxisCol~&(a, -1)
    ScrPt gzC.x - ax * 3, gzC.y - ay * 3, gzC.z - az * 3, sx0, sy0, ok
    ScrPt gzC.x + ax * 3, gzC.y + ay * 3, gzC.z + az * 3, sx1, sy1, ok2
    IF ok AND ok2 THEN LINE (sx0, sy0)-(sx1, sy1), c
    st = snapStep: IF st <= 0 THEN st = 1 / 16
    n = INT(.5 / st): IF n > 48 THEN n = 48
    ScrPt gzC.x, gzC.y, gzC.z, sx0, sy0, ok
    ScrPt gzC.x + ax * st, gzC.y + ay * st, gzC.z + az * st, sx1, sy1, ok2
    IF ok = 0 OR ok2 = 0 THEN EXIT SUB
    dx = sx1 - sx0: dy = sy1 - sy0: l = SQR(dx * dx + dy * dy): IF l < 3 THEN EXIT SUB ' (ticks too close to see)
    px = -dy / l: py = dx / l
    ' (ticks on the grid's steps - where it snaps - near what's moving)
    FOR i = -n TO n
        x = gzC.x: y = gzC.y: z = gzC.z
        SELECT CASE a
            CASE 1: x = (INT(gzC.x / st + .5) + i) * st
            CASE 2: y = (INT(gzC.y / st + .5) + i) * st
            CASE ELSE: z = (INT(gzC.z / st + .5) + i) * st
        END SELECT
        ScrPt x, y, z, sx0, sy0, ok
        IF ok THEN LINE (sx0 - px * 4, sy0 - py * 4)-(sx0 + px * 4, sy0 + py * 4), IIFC~&(i MOD 4 = 0, c, _RGBA32(_RED32(c), _GREEN32(c), _BLUE32(c), 140))
    NEXT
END SUB

' The axis a drag keeps to now: the arrow grabbed, else X, Y or Z held (0: none)
FUNCTION DragAxisNow
    IF gzAxis THEN DragAxisNow = gzAxis: EXIT FUNCTION
    IF _KEYDOWN(120) OR _KEYDOWN(88) THEN DragAxisNow = 1: EXIT FUNCTION
    IF _KEYDOWN(121) OR _KEYDOWN(89) THEN DragAxisNow = 2: EXIT FUNCTION
    IF _KEYDOWN(122) OR _KEYDOWN(90) THEN DragAxisNow = 3: EXIT FUNCTION
END FUNCTION

' How far along axis a (through g) the pointer at view pixel (lx, ly) is
FUNCTION AxisAt# (lx, ly, g AS V3, a)
    DIM d AS V3, ax, ay, az, wx#, wy#, wz#, b#, dd#, ee#
    ViewRay lx, ly, d
    AxisVec a, ax, ay, az
    wx# = g.x - cEX: wy# = g.y - cEY: wz# = g.z - cEZ
    b# = ax * d.x + ay * d.y + az * d.z
    IF 1 - b# * b# < 1E-6 THEN EXIT FUNCTION ' (looking straight down it)
    dd# = ax * wx# + ay * wy# + az * wz#: ee# = d.x * wx# + d.y * wy# + d.z * wz#
    AxisAt# = (b# * ee# - dd#) / (1 - b# * b#)
END FUNCTION

' A press on an arrow: the drag along it begins (1: it was)
FUNCTION GzPress
    IF gzHover = 0 OR NOT gzOk THEN EXIT FUNCTION
    gzAxis = gzHover: dragG = gzC: dragPX = mX: dragPY = mY
    IF edPart THEN
        edArm = -1
    ELSE
        dragArm = -1: dragFirst = SelFirst
    END IF
    GzPress = -1
END FUNCTION

' ---------------------------------------------------------------- TRANSFORM

' Its row in the panel (parts selected, or in E): k 1 MOVE, 2 SCALE, 3 TURN, 4-6 X Y Z
SUB TfBtn (k, x, y, w, h)
    y = 450: h = 22
    IF k <= 3 THEN x = PX0 + (k - 1) * 49: w = 47 ELSE x = PX0 + 152 + (k - 4) * 27: w = 25
END SUB

FUNCTION TfShown
    TfShown = (edPart <> 0 OR SelCount > 0) AND placeKind = 0
END FUNCTION

SUB TfDraw
    DIM k, x, y, w, h
    IF NOT TfShown THEN EXIT SUB
    Txt PX0, 432, "TRANSFORM  (drag: these ways)", cDim
    FOR k = 1 TO 6
        TfBtn k, x, y, w, h
        IF k <= 3 THEN
            Btn x, y, w, h, TfName$(k - 1), (tfMode = k - 1)
        ELSE
            Btn x, y, w, h, MID$("XYZ", k - 3, 1), tfAx(k - 3) <> 0
            IF tfAx(k - 3) THEN LINE (x + 2, y + h - 3)-(x + w - 3, y + h - 3), AxisCol~&(k - 3, -1)
        END IF
    NEXT
END SUB

FUNCTION TfName$ (m)
    SELECT CASE m
        CASE 0: TfName$ = "MOVE"
        CASE 1: TfName$ = "SCALE"
        CASE ELSE: TfName$ = "TURN"
    END SELECT
END FUNCTION

' A click on its row (1: it was)
FUNCTION TfClick
    DIM k, x, y, w, h, a
    IF NOT TfShown THEN EXIT FUNCTION
    FOR k = 1 TO 6
        TfBtn k, x, y, w, h
        IF InRect(mX, mY, x, y, w, h) THEN
            IF k <= 3 THEN
                tfMode = k - 1
                Msg TfName$(tfMode) + ": dragging what's selected (or the widget's ends) " + LCASE$(TfName$(tfMode)) + "s it - X Y Z: which ways"
            ELSE
                a = k - 3: tfAx(a) = NOT tfAx(a)
                IF TfCount = 0 THEN tfAx(a) = -1: Msg "At least one way stays on" ' (none: as good as all)
            END IF
            TfClick = -1: EXIT FUNCTION
        END IF
    NEXT
END FUNCTION

' How many axes TRANSFORM has on, and the first of them (Y first: what turning goes round, mostly)
FUNCTION TfCount
    TfCount = -(tfAx(1) <> 0) - (tfAx(2) <> 0) - (tfAx(3) <> 0)
END FUNCTION

FUNCTION TfFirst
    IF tfAx(2) THEN TfFirst = 2 ELSE IF tfAx(1) THEN TfFirst = 1 ELSE TfFirst = 3
END FUNCTION

' The axes a drag works on now: the arrow grabbed (or X / Y / Z held), else TRANSFORM's
FUNCTION TfOn (a)
    DIM d
    d = DragAxisNow
    IF d THEN TfOn = (a = d) ELSE TfOn = (tfAx(a) <> 0)
END FUNCTION

' How much bigger a SCALE drag makes things: along the arrow grabbed, else
' how much farther from the widget's middle the pointer is than it began (twice
' as far: twice the size)
FUNCTION TfScaleK# (lx, ly)
    DIM a, t0#, t1#, sx, sy, ok, d0#, d1#, k#
    k# = 1
    a = DragAxisNow
    IF a <> 0 AND gzAxis <> 0 THEN
        t0# = AxisAt#(dragLX0, dragLY0, dragC, a): t1# = AxisAt#(lx, ly, dragC, a)
        IF ABS(t0#) > 1E-6 THEN k# = t1# / t0#
    ELSE
        ScrPt dragC.x, dragC.y, dragC.z, sx, sy, ok
        IF ok THEN
            d0# = SQR((dragLX0 + vX0 - sx) ^ 2 + (dragLY0 + vY0 - sy) ^ 2): d1# = SQR((lx + vX0 - sx) ^ 2 + (ly + vY0 - sy) ^ 2)
            k# = 1 + (d1# - d0#) / IIF(d0# > 64, d0#, 64) ' (grabbed near the middle: as if as far out as the widget's arrows)
        END IF
    END IF
    IF k# < .01 THEN k# = .01
    TfScaleK# = k#
END FUNCTION

' How far round a TURN drag goes (degrees, and the axis): the pointer's angle round
' the widget's middle on the screen, from where it began; 15 at a time on the grid (Alt: 1)
FUNCTION TfTurnD (lx, ly, a)
    DIM sx, sy, ok, a0#, a1#, d#, ax, ay, az, s
    a = DragAxisNow: IF a = 0 THEN a = TfFirst
    ScrPt dragC.x, dragC.y, dragC.z, sx, sy, ok: IF ok = 0 THEN EXIT FUNCTION
    a0# = _ATAN2(dragLY0 + vY0 - sy, dragLX0 + vX0 - sx): a1# = _ATAN2(ly + vY0 - sy, lx + vX0 - sx)
    d# = (a1# - a0#) * 180 / 3.14159265358979
    DO WHILE d# > 180: d# = d# - 360: LOOP
    DO WHILE d# < -180: d# = d# + 360: LOOP
    ' (clockwise on the screen is clockwise round the axis as it points at you)
    AxisVec a, ax, ay, az
    s = 1: IF ax * cFX + ay * cFY + az * cFZ > 0 THEN s = -1
    d# = -d# * s
    IF snapStep > 0 AND NOT kAlt THEN d# = 15 * INT(d# / 15 + .5) ELSE d# = INT(d# + .5)
    TfTurnD = d#
END FUNCTION

' A SCALE or TURN drag of the selected parts, from where they were when it began
SUB TfPartsUpdate (lx, ly)
    DIM i, a, k#, d, q#, c#, sz#, sh
    IF tfMode = 1 THEN
        k# = TfScaleK#(lx, ly): a = DragAxisNow: dragAxis = a
        FOR i = 1 TO pN
            IF pSel(i) THEN
                sh = (pKind(i) <> K_USE AND pKind(i) <> K_MESH) ' (a shape's size lands on the grid; a scale doesn't)
                pX(i) = dragX0(i): pY(i) = dragY0(i): pZ(i) = dragZ0(i)
                pSX(i) = dragSX0(i): pSY(i) = dragSY0(i): pSZ(i) = dragSZ0(i)
                IF TfOn(1) THEN sz# = dragSX0(i) * k#: IF sh THEN pSX(i) = GridSnap#(sz#, 2 * snapStep, -1) ELSE pSX(i) = TfScaleOn#(sz#, dragNat#(i, 1), 2 * snapStep)
                IF TfOn(2) THEN sz# = dragSY0(i) * k#: IF sh THEN pSY(i) = GridSnap#(sz#, snapStep, -1) ELSE pSY(i) = TfScaleOn#(sz#, dragNat#(i, 2), snapStep)
                IF TfOn(3) THEN sz# = dragSZ0(i) * k#: IF sh THEN pSZ(i) = GridSnap#(sz#, 2 * snapStep, -1) ELSE pSZ(i) = TfScaleOn#(sz#, dragNat#(i, 3), 2 * snapStep)
                IF tfPivOn THEN ' (from the pivot: it stays put - each way by how much this one grew)
                    TfPivMove i, k#
                ELSEIF SelCount > 1 THEN ' (several: their places spread from the middle too - up from the bottom)
                    IF TfOn(1) THEN c# = (dragLo.x + dragHi.x) / 2: pX(i) = VAL(Fmt$(c# + (dragX0(i) - c#) * k#))
                    IF TfOn(2) THEN c# = dragLo.y: pY(i) = VAL(Fmt$(c# + (dragY0(i) - c#) * k#))
                    IF TfOn(3) THEN c# = (dragLo.z + dragHi.z) / 2: pZ(i) = VAL(Fmt$(c# + (dragZ0(i) - c#) * k#))
                END IF
            END IF
        NEXT
        Msg "SCALE x" + Fmt$(k#) + " (" + IIFS$(TfOn(1), "X", "") + IIFS$(TfOn(2), "Y", "") + IIFS$(TfOn(3), "Z", "") + ")" + IIFS$(snapStep > 0, " - sizes on the grid (Alt: free)", "")
    ELSE
        d = TfTurnD(lx, ly, a): dragAxis = a
        FOR i = 1 TO pN
            IF pSel(i) THEN pX(i) = dragX0(i): pY(i) = dragY0(i): pZ(i) = dragZ0(i): pRX(i) = dragRX0(i): pRY(i) = dragRY0(i): pRZ(i) = dragRZ0(i)
        NEXT
        IF d THEN SelTurnAbout a - 1, d, dragC.x, dragC.y, dragC.z
        Msg "TURN" + STR$(d) + " round " + MID$("XYZ", a, 1) + IIFS$(snapStep > 0, " (15 at a time; Alt: 1)", "")
    END IF
    ModelChanged
END SUB

' A SCALE or TURN drag of E's moving points, from where they were (edX0..) round dragC
' A mesh part's or prefab use's scale s#, made so its size that way (its own size
' nat# times it) lands on the grid's steps q# (nat# 0: not known - as it is)
FUNCTION TfScaleOn# (s#, nat#, q#)
    DIM r#
    r# = s#
    IF nat# > 1E-6 THEN r# = GridSnap#(s# * nat#, q#, -1) / nat#
    TfScaleOn# = PosSize(r#)
END FUNCTION

' Each selected mesh part's / use's own size (at scale 1) along its own X Y Z, in dragNat#:
' a mesh's from its points; a use's from its triangles when it isn't turned (turned: 0)
SUB TfNatAll
    DIM i, v AS LONG, id AS LONG, x, y, z, a, t AS LONG
    DIM lo(3) AS DOUBLE, hi(3) AS DOUBLE
    FOR i = 1 TO pN
        dragNat#(i, 1) = 0: dragNat#(i, 2) = 0: dragNat#(i, 3) = 0
        IF pSel(i) AND (pKind(i) = K_MESH OR pKind(i) = K_USE) THEN
            FOR a = 1 TO 3: lo(a) = 1E+30: hi(a) = -1E+30: NEXT
            IF pKind(i) = K_MESH THEN
                id = pMesh(i)
                FOR v = 0 TO mbVN(id) - 1
                    MbPt id, v, x, y, z
                    IF x < lo(1) THEN lo(1) = x
                    IF x > hi(1) THEN hi(1) = x
                    IF y < lo(2) THEN lo(2) = y
                    IF y > hi(2) THEN hi(2) = y
                    IF z < lo(3) THEN lo(3) = z
                    IF z > hi(3) THEN hi(3) = z
                NEXT
                FOR a = 1 TO 3: IF hi(a) > lo(a) THEN dragNat#(i, a) = hi(a) - lo(a)
                NEXT
            ELSEIF pRX(i) = 0 AND pRY(i) = 0 AND pRZ(i) = 0 THEN
                FOR t = 1 TO holeTN
                    IF tPart(t) = i THEN
                        FOR a = 1 TO 3
                            TfGrowAxis lo(a), hi(a), tA(t), a: TfGrowAxis lo(a), hi(a), tB(t), a: TfGrowAxis lo(a), hi(a), tC(t), a
                        NEXT
                    END IF
                NEXT
                IF hi(1) > lo(1) AND pSX(i) > 0 THEN dragNat#(i, 1) = (hi(1) - lo(1)) / pSX(i)
                IF hi(2) > lo(2) AND pSY(i) > 0 THEN dragNat#(i, 2) = (hi(2) - lo(2)) / pSY(i)
                IF hi(3) > lo(3) AND pSZ(i) > 0 THEN dragNat#(i, 3) = (hi(3) - lo(3)) / pSZ(i)
            END IF
        END IF
    NEXT
END SUB

SUB TfGrowAxis (lo AS DOUBLE, hi AS DOUBLE, p AS V3, a)
    DIM v#
    IF a = 1 THEN v# = p.x ELSE IF a = 2 THEN v# = p.y ELSE v# = p.z
    IF v# < lo THEN lo = v#
    IF v# > hi THEN hi = v#
END SUB

SUB TfEdUpdate (lx, ly)
    DIM w AS LONG, x#, y#, z#, k#, d, a, c#, s#, p#, q#, lo#(3), hi#(3), kk#(3)
    IF tfMode = 1 THEN
        k# = TfScaleK#(lx, ly): dragAxis = DragAxisNow
        ' (each way the picked points' box lands on the grid - Alt: free)
        FOR a = 1 TO 3: lo#(a) = 1E30: hi#(a) = -1E30: NEXT
        FOR w = 1 TO swN
            IF edMv(w) THEN
                IF edX0(w) < lo#(1) THEN lo#(1) = edX0(w)
                IF edX0(w) > hi#(1) THEN hi#(1) = edX0(w)
                IF edY0(w) < lo#(2) THEN lo#(2) = edY0(w)
                IF edY0(w) > hi#(2) THEN hi#(2) = edY0(w)
                IF edZ0(w) < lo#(3) THEN lo#(3) = edZ0(w)
                IF edZ0(w) > hi#(3) THEN hi#(3) = edZ0(w)
            END IF
        NEXT
        FOR a = 1 TO 3
            kk#(a) = k#
            IF hi#(a) - lo#(a) > 1E-6 THEN kk#(a) = GridSnap#((hi#(a) - lo#(a)) * k#, 2 * snapStep, -1) / (hi#(a) - lo#(a))
        NEXT
        FOR w = 1 TO swN
            IF edMv(w) THEN
                x# = edX0(w): y# = edY0(w): z# = edZ0(w)
                IF TfOn(1) THEN x# = dragC.x + (x# - dragC.x) * kk#(1)
                IF TfOn(2) THEN y# = dragC.y + (y# - dragC.y) * kk#(2)
                IF TfOn(3) THEN z# = dragC.z + (z# - dragC.z) * kk#(3)
                EdSetW w, x#, y#, z#
            END IF
        NEXT
        Msg "SCALE x" + Fmt$(k#)
    ELSE
        d = TfTurnD(lx, ly, a): dragAxis = a
        c# = COS(d * 3.14159265358979 / 180): s# = SIN(d * 3.14159265358979 / 180)
        FOR w = 1 TO swN
            IF edMv(w) THEN
                x# = edX0(w) - dragC.x: y# = edY0(w) - dragC.y: z# = edZ0(w) - dragC.z
                SELECT CASE a ' (as EdTurnWork)
                    CASE 1: p# = y# * c# - z# * s#: q# = y# * s# + z# * c#: y# = p#: z# = q#
                    CASE 2: p# = x# * c# + z# * s#: q# = -x# * s# + z# * c#: x# = p#: z# = q#
                    CASE ELSE: p# = x# * c# - y# * s#: q# = x# * s# + y# * c#: x# = p#: y# = q#
                END SELECT
                EdSetW w, x# + dragC.x, y# + dragC.y, z# + dragC.z
            END IF
        NEXT
        Msg "TURN" + STR$(d) + " round " + MID$("XYZ", a, 1)
    END IF
    EdCommit
END SUB

' ---------------------------------------------------------------- the pivot (Ctrl+Alt+click)

' Whose pivot it is: the selection (or E's part)
FUNCTION PivKey$
    DIM i, k$
    IF edPart THEN PivKey$ = "E" + STR$(edPart): EXIT FUNCTION
    FOR i = 1 TO pN
        IF pSel(i) THEN k$ = k$ + MKI$(i)
    NEXT
    PivKey$ = k$
END FUNCTION

' Ghost point k of the selection's box: 0 its middle, 1-6 each side's middle (-x +x -y +y -z +z), 7-14 its corners
SUB PivGhost (k, p AS V3)
    DIM m AS V3
    m.x = (gzLo.x + gzHi.x) / 2: m.y = (gzLo.y + gzHi.y) / 2: m.z = (gzLo.z + gzHi.z) / 2
    p = m
    SELECT CASE k
        CASE 1: p.x = gzLo.x
        CASE 2: p.x = gzHi.x
        CASE 3: p.y = gzLo.y
        CASE 4: p.y = gzHi.y
        CASE 5: p.z = gzLo.z
        CASE 6: p.z = gzHi.z
        CASE 7 TO 14
            p.x = IIF((k - 7) AND 1, gzHi.x, gzLo.x): p.y = IIF((k - 7) AND 2, gzHi.y, gzLo.y): p.z = IIF((k - 7) AND 4, gzHi.z, gzLo.z)
    END SELECT
END SUB

' The ghost point under the pointer (-1 none)
FUNCTION PivGhostAt
    DIM k, p AS V3, sx, sy, ok, best, d
    PivGhostAt = -1: best = 81
    FOR k = 0 TO 14
        PivGhost k, p
        ScrPt p.x, p.y, p.z, sx, sy, ok
        IF ok THEN
            d = (sx - mX) ^ 2 + (sy - mY) ^ 2
            IF d < best THEN best = d: PivGhostAt = k
        END IF
    NEXT
END FUNCTION

' Ctrl+Alt held: the box's ghost points; the pivot, ringed
SUB PivDraw
    DIM k, p AS V3, sx, sy, ok, hot, r, c AS _UNSIGNED LONG
    IF tfPivOn AND gzOk THEN
        ScrPt gzC.x, gzC.y, gzC.z, sx, sy, ok
        IF ok THEN CIRCLE (sx, sy), 9, _RGB32(255, 220, 90): CIRCLE (sx, sy), 8, _RGB32(10, 8, 18)
    END IF
    IF NOT (kCtrl AND kAlt) OR NOT gzOk THEN EXIT SUB
    hot = PivGhostAt
    FOR k = 0 TO 14
        PivGhost k, p
        ScrPt p.x, p.y, p.z, sx, sy, ok
        IF ok THEN
            c = _RGB32(230, 225, 255): IF k = hot THEN c = _RGB32(255, 220, 90)
            r = 5: IF k > 6 THEN r = 4 ' (corners a little smaller)
            IF k = hot THEN r = r + 2
            PivDiamond sx, sy, r + 1, _RGB32(10, 8, 18)
            PivDiamond sx, sy, r, c
            PivDiamond sx, sy, r - 1, c
            IF k = 0 THEN PivDiamond sx, sy, 2, c: PSET (sx, sy), c
        END IF
    NEXT
    Txt vX0 + 8, vY0 + vH - 20, "PIVOT: click a ghost point (the middle: none) or a spot on the shape - SCALE grows from it, TURN turns round it", cHi
END SUB

SUB PivDiamond (x, y, r, c AS _UNSIGNED LONG)
    LINE (x - r, y)-(x, y - r), c: LINE (x, y - r)-(x + r, y), c
    LINE (x + r, y)-(x, y + r), c: LINE (x, y + r)-(x - r, y), c
END SUB

' Ctrl+Alt+click in the view: the pivot set (a ghost point, or the spot on the selection under the pointer, on the grid)
SUB PivPick (lx, ly)
    DIM k, t AS LONG, p AS V3, n AS V3, ok, st#
    k = PivGhostAt
    IF k = 0 THEN tfPivOn = 0: Msg "Pivot: the middle again": EXIT SUB
    IF k > 0 THEN
        PivGhost k, p
    ELSE
        t = PickTri(lx, ly)
        IF t < 1 OR t > holeTN THEN tfPivOn = 0: Msg "Pivot: the middle again (Ctrl+Alt+click a ghost point or the shape to set one)": EXIT SUB
        n = tNrm(t)
        RayPlane lx, ly, tA(t), n, p, ok
        IF ok = 0 THEN EXIT SUB
        st# = snapStep
        IF st# > 0 THEN p.x = INT(p.x / st# + .5) * st#: p.y = INT(p.y / st# + .5) * st#: p.z = INT(p.z / st# + .5) * st#
    END IF
    tfPiv = p: tfPivOn = -1: tfPivKey$ = PivKey$
    Msg "Pivot at" + STR$(VAL(Fmt$(p.x))) + "," + STR$(VAL(Fmt$(p.y))) + "," + STR$(VAL(Fmt$(p.z))) + ": SCALE grows from here (it stays put), TURN turns round it. Ctrl+Alt+click the middle: none"
END SUB

' Part i's place moved so its growth (its size now against at the drag's start) keeps the pivot put
SUB TfPivMove (i, k#)
    DIM kx#, ky#, kz#
    kx# = k#: ky# = k#: kz# = k#
    IF pRX(i) = 0 AND pRY(i) = 0 AND pRZ(i) = 0 THEN ' (unturned: each way by its own (snapped) growth)
        IF dragSX0(i) > 0 THEN kx# = pSX(i) / dragSX0(i)
        IF dragSY0(i) > 0 THEN ky# = pSY(i) / dragSY0(i)
        IF dragSZ0(i) > 0 THEN kz# = pSZ(i) / dragSZ0(i)
    END IF
    IF TfOn(1) THEN pX(i) = VAL(Fmt$(tfPiv.x + (dragX0(i) - tfPiv.x) * kx#))
    IF TfOn(2) THEN pY(i) = VAL(Fmt$(tfPiv.y + (dragY0(i) - tfPiv.y) * ky#))
    IF TfOn(3) THEN pZ(i) = VAL(Fmt$(tfPiv.z + (dragZ0(i) - tfPiv.z) * kz#))
END SUB
