''
' bu1ld0r - MODEL/PARTS.BM
' =============================================================================
' Parts added, copied, taken away; the model as text (its .bld file, and
' each undo step); NEW, OPEN, SAVE.
'

SUB PartsSetup
    DIM k
    kindName$(K_BOX) = "box": kindName$(K_CYL) = "cylinder": kindName$(K_SPHERE) = "sphere"
    kindName$(K_CONE) = "cone": kindName$(K_WEDGE) = "wedge": kindName$(K_TUBE) = "tube"
    FOR k = 1 TO NUM_KINDS: kindSX(k) = 0.25: kindSY(k) = 0.25: kindSZ(k) = 0.25: NEXT
    kindSY(K_CYL) = 0.3: kindSY(K_TUBE) = 0.15: kindAmt(K_TUBE) = 0.6: kindAmt(K_SPHERE) = 1
    kindName$(K_USE) = "prefab": kindSX(K_USE) = 1: kindSY(K_USE) = 1: kindSZ(K_USE) = 1 ' (a prefab's size is its scale)
    FOR k = 1 TO K_USE: defSX(k) = kindSX(k): defSY(k) = kindSY(k): defSZ(k) = kindSZ(k): NEXT
    snapStep = 1 / 32
    curCol = _RGB32(76, 255, 255) ' (ANSI32's cyan, 4CFFFF)
    defCol = curCol
END SUB

FUNCTION KindOf (n$)
    DIM k
    FOR k = 1 TO NUM_KINDS
        IF LCASE$(n$) = kindName$(k) THEN KindOf = k: EXIT FUNCTION
    NEXT
END FUNCTION

' Part i set to a new kind's usual size, standing at x, y, z
SUB PartFresh (i, k, x, y, z)
    pKind(i) = k: pX(i) = x: pY(i) = y: pZ(i) = z
    pRX(i) = 0: pRY(i) = 0: pRZ(i) = 0
    pSX(i) = kindSX(k): pSY(i) = kindSY(k): pSZ(i) = kindSZ(k)
    pAmt(i) = kindAmt(k): pSeg(i) = 0: pCol(i) = curCol: pSel(i) = 0: pRef$(i) = ""
    pHole(i) = 0: pHide(i) = 0: pWire(i) = 0: pName$(i) = ""
END SUB

' Part a copied over part b (all but whether it's selected)
SUB PartCopy (a, b)
    pKind(b) = pKind(a): pX(b) = pX(a): pY(b) = pY(a): pZ(b) = pZ(a)
    pRX(b) = pRX(a): pRY(b) = pRY(a): pRZ(b) = pRZ(a)
    pSX(b) = pSX(a): pSY(b) = pSY(a): pSZ(b) = pSZ(a)
    pAmt(b) = pAmt(a): pSeg(b) = pSeg(a): pCol(b) = pCol(a): pRef$(b) = pRef$(a)
    pHole(b) = pHole(a): pHide(b) = pHide(a): pWire(b) = pWire(a): pName$(b) = pName$(a)
END SUB

' The ghost (part 0) put in the model as a part of its own: its number
FUNCTION PartFromGhost
    IF pN >= MAX_PARTS THEN Msg "The model is full (" + LTRIM$(STR$(MAX_PARTS)) + " parts)": EXIT FUNCTION
    pN = pN + 1: PartCopy 0, pN: pSel(pN) = 0
    PartFromGhost = pN
    ' (the next of this kind starts as big as this one - a prefab always as made)
    IF pKind(0) <> K_USE THEN kindSX(pKind(0)) = pSX(0): kindSY(pKind(0)) = pSY(0): kindSZ(pKind(0)) = pSZ(0)
END FUNCTION

SUB SelNone
    DIM i
    FOR i = 1 TO pN: pSel(i) = 0: NEXT
END SUB

FUNCTION SelCount
    DIM i, n
    FOR i = 1 TO pN
        IF pSel(i) THEN n = n + 1
    NEXT
    SelCount = n
END FUNCTION

FUNCTION SelFirst
    DIM i
    FOR i = 1 TO pN
        IF pSel(i) THEN SelFirst = i: EXIT FUNCTION
    NEXT
END FUNCTION

SUB SelDelete
    DIM i, j
    IF SelCount = 0 THEN EXIT SUB
    UndoPush
    j = 0
    FOR i = 1 TO pN
        IF pSel(i) = 0 THEN j = j + 1: PartCopy i, j: pSel(j) = 0
    NEXT
    Msg LTRIM$(STR$(pN - j)) + " taken away"
    pN = j: ModelChanged
END SUB

' Each selected part copied, a grid step along: the copies selected
SUB SelDuplicate
    DIM i, n, st
    n = pN: IF SelCount = 0 THEN EXIT SUB
    UndoPush
    st = snapStep: IF st <= 0 THEN st = 1 / 32
    FOR i = 1 TO n
        IF pSel(i) AND pN < MAX_PARTS THEN
            pN = pN + 1: PartCopy i, pN: pX(pN) = pX(pN) + st * 2: pSel(pN) = -1: pSel(i) = 0
        END IF
    NEXT
    Msg "Copied: the copies are selected": ModelChanged
END SUB

' The model as text: the .bld file, and each undo step
FUNCTION ModelText$
    DIM i, t$, nl$
    nl$ = CHR$(10)
    t$ = "bu1ld0r 1" + nl$ + "name " + mdlName$ + nl$
    FOR i = 1 TO pN
        t$ = t$ + PartLine$(i) + nl$
    NEXT
    ModelText$ = t$
END FUNCTION

' part KIND  x y z  turns  sizes  RRGGBB  slices  amount; or a prefab: use NAME  x y z  turns  scales
FUNCTION PartLine$ (i)
    DIM t$
    t$ = Fmt$(pX(i)) + " " + Fmt$(pY(i)) + " " + Fmt$(pZ(i)) + "  " + Fmt$(pRX(i)) + " " + Fmt$(pRY(i)) + " " + Fmt$(pRZ(i)) + "  " + Fmt$(pSX(i)) + " " + Fmt$(pSY(i)) + " " + Fmt$(pSZ(i))
    IF pKind(i) = K_USE THEN
        t$ = "use " + pRef$(i) + "  " + t$
    ELSE
        t$ = "part " + kindName$(pKind(i)) + "  " + t$ + "  " + HexCol$(pCol(i)) + "  " + LTRIM$(STR$(pSeg(i))) + "  " + Fmt$(pAmt(i))
    END IF
    ' (then its flags, words of their own after the numbers: older copies leave them out)
    IF pHole(i) THEN t$ = t$ + "  hole"
    IF pHide(i) THEN t$ = t$ + "  hide"
    IF pWire(i) THEN t$ = t$ + "  wire"
    IF LEN(pName$(i)) THEN t$ = t$ + "  name=" + pName$(i)
    PartLine$ = t$
END FUNCTION

' The model read back from text
SUB ModelFromText (t$)
    pN = PartsFromText&(t$, 0, MAX_PARTS)
    IF LEN(txtName$) THEN mdlName$ = txtName$
END SUB

' A .bld's parts read into at0 + 1 on (room of them at most): how many.
' The lines it doesn't know are left out; its name line goes in txtName$.
FUNCTION PartsFromText& (t$, at0 AS LONG, room AS LONG)
    DIM p AS LONG, j AS LONG, l$, k, ok, c AS _UNSIGNED LONG, n AS LONG, i, w
    n = 0: p = 1: txtName$ = ""
    DO WHILE p <= LEN(t$)
        j = INSTR(p, t$, CHR$(10)): IF j = 0 THEN j = LEN(t$) + 1
        l$ = MID$(t$, p, j - p): p = j + 1
        IF RIGHT$(l$, 1) = CHR$(13) THEN l$ = LEFT$(l$, LEN(l$) - 1)
        Words l$
        IF wdN >= 2 THEN
            k = 0
            SELECT CASE LCASE$(wd$(1))
                CASE "name": txtName$ = MID$(LTRIM$(l$), 6)
                CASE "part": IF wdN >= 12 THEN k = KindOf(wd$(2))
                CASE "use": IF wdN >= 11 THEN k = K_USE
            END SELECT
            IF k > 0 AND n < room THEN
                n = n + 1: i = at0 + n
                PartFresh i, k, VAL(wd$(3)), VAL(wd$(4)), VAL(wd$(5))
                pRX(i) = VAL(wd$(6)): pRY(i) = VAL(wd$(7)): pRZ(i) = VAL(wd$(8))
                pSX(i) = PosSize(VAL(wd$(9))): pSY(i) = PosSize(VAL(wd$(10))): pSZ(i) = PosSize(VAL(wd$(11)))
                IF k = K_USE THEN
                    pRef$(i) = wd$(2)
                ELSE
                    c = ParseCol~&(wd$(12), ok): IF ok THEN pCol(i) = c
                    IF wdN >= 13 THEN pSeg(i) = VAL(wd$(13))
                    IF wdN >= 14 THEN pAmt(i) = Clamp(VAL(wd$(14)), 0, 1)
                END IF
                FOR w = 12 TO wdN
                    SELECT CASE LCASE$(wd$(w))
                        CASE "hole": pHole(i) = -1
                        CASE "hide": pHide(i) = -1
                        CASE "wire": pWire(i) = -1
                        CASE ELSE: IF LCASE$(LEFT$(wd$(w), 5)) = "name=" THEN pName$(i) = MID$(wd$(w), 6)
                    END SELECT
                NEXT
            END IF
        END IF
    LOOP
    PartsFromText& = n
END FUNCTION

FUNCTION PosSize (v)
    PosSize = v: IF v < 0.001 THEN PosSize = 0.001
END FUNCTION

' Every change: the mesh to make again, the view to draw again, not saved
SUB ModelChanged
    meshDirty = -1: viewDirty = -1: mdlDirty = -1: mdlAsk = 0: askRef$ = ""
END SUB

SUB UndoPush
    DIM i
    IF undoN >= MAX_UNDO THEN
        FOR i = 1 TO MAX_UNDO - 1: undoS$(i) = undoS$(i + 1): NEXT
        undoN = MAX_UNDO - 1
    END IF
    undoN = undoN + 1: undoS$(undoN) = ModelText$
    redoN = 0
END SUB

SUB UndoStep
    IF undoN = 0 THEN Msg "Nothing to undo": EXIT SUB
    IF redoN < MAX_UNDO THEN redoN = redoN + 1: redoS$(redoN) = ModelText$
    ModelFromText undoS$(undoN): undoN = undoN - 1
    Msg "Undone (Ctrl+Y: again)": ModelChanged
END SUB

SUB RedoStep
    IF redoN = 0 THEN Msg "Nothing to redo": EXIT SUB
    IF undoN < MAX_UNDO THEN undoN = undoN + 1: undoS$(undoN) = ModelText$
    ModelFromText redoS$(redoN): redoN = redoN - 1
    Msg "Redone": ModelChanged
END SUB

SUB ModelNew
    pN = 0: undoN = 0: redoN = 0: mdlName$ = "untitled": mdlPf$ = ""
    ModelChanged: mdlDirty = 0
END SUB

FUNCTION ModelPath$ (n$)
    ModelPath$ = appDir$ + "models/" + n$ + ".bld"
END FUNCTION

' A name a file can have: letters, digits, - and _ (spaces become -)
FUNCTION SafeName$ (n$)
    DIM i, ch$, o$
    FOR i = 1 TO LEN(n$)
        ch$ = LCASE$(MID$(n$, i, 1))
        IF ch$ = " " THEN ch$ = "-"
        IF INSTR("abcdefghijklmnopqrstuvwxyz0123456789-_", ch$) THEN o$ = o$ + ch$
    NEXT
    IF o$ = "" THEN o$ = "untitled"
    SafeName$ = o$
END FUNCTION

SUB ModelSave
    DIM fh, f$, t$
    mdlName$ = SafeName$(mdlName$)
    IF LEN(mdlPf$) THEN PrefabWrite PfFolder$(mdlPf$) + mdlName$: EXIT SUB ' (a prefab open: saved back to prefabs/)
    f$ = ModelPath$(mdlName$)
    t$ = ModelText$
    fh = FREEFILE: OPEN f$ FOR OUTPUT AS #fh: PRINT #fh, t$;: CLOSE #fh
    mdlDirty = 0
    Msg "Saved " + f$
END SUB

' f$: a path, or a name in models/
SUB ModelLoad (f$)
    DIM fh, t$, p$, i
    p$ = f$
    IF NOT _FILEEXISTS(p$) THEN p$ = ModelPath$(f$)
    IF NOT _FILEEXISTS(p$) THEN Msg "No such model: " + f$: EXIT SUB
    fh = FREEFILE: OPEN p$ FOR BINARY AS #fh: t$ = SPACE$(LOF(fh)): GET #fh, , t$: CLOSE #fh
    ModelFromText t$
    mdlPf$ = "" ' (PfEdit says when it's a prefab)
    i = _INSTRREV(p$, "/"): mdlName$ = MID$(p$, i + 1): IF LCASE$(RIGHT$(mdlName$, 4)) = ".bld" THEN mdlName$ = LEFT$(mdlName$, LEN(mdlName$) - 4) ' (named for its file)
    undoN = 0: redoN = 0
    ModelChanged: mdlDirty = 0
    ViewFrameAll
    t$ = ModelMissing$
    IF LEN(t$) THEN
        Msg "Opened " + mdlName$ + " - but prefab " + t$ + " isn't in prefabs/ (a red box stands in): EXPORT waits for it"
    ELSE
        Msg "Opened " + p$ + " - " + LTRIM$(STR$(pN)) + " parts"
    END IF
END SUB
