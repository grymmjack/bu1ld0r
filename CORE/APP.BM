''
' bu1ld0r - CORE/APP.BM
' =============================================================================
' Start-up, the mouse and keys each frame, and small helpers.
'

SUB AppStart
    DIM a$, i, k$
    _TITLE APP_NAME$ + " " + APP_VERSION$
    _DISPLAYORDER _HARDWARE ' (only Present's picture is shown: the window's SCREEN is never drawn on)
    cBg = _RGB32(14, 12, 24): cPanel = _RGB32(24, 22, 38): cLine = _RGB32(60, 54, 90)
    cText = _RGB32(225, 225, 240): cDim = _RGB32(130, 125, 160): cHi = _RGB32(0, 240, 255)
    cSel = _RGB32(255, 60, 200): cBtn = _RGB32(40, 36, 62): cHover = _RGB32(62, 56, 96): cWarn = _RGB32(255, 190, 60)

    ' Where the program is (its folders are beside it), from its own path
    a$ = COMMAND$(0)
    i = _INSTRREV(a$, "/"): IF _INSTRREV(a$, "\") > i THEN i = _INSTRREV(a$, "\")
    IF i THEN appDir$ = LEFT$(a$, i) ELSE appDir$ = "./"
    IF NOT _DIREXISTS(appDir$ + "models") THEN MKDIR appDir$ + "models"
    IF NOT _DIREXISTS(appDir$ + "export") THEN MKDIR appDir$ + "export"
    IF NOT _DIREXISTS(appDir$ + "prefabs") THEN MKDIR appDir$ + "prefabs"
    listOn = -1 ' (the parts list, unless bu1ld0r.cfg says parts_list=0)
    gridWalls = -1 ' (the grid up the walls: grid_walls=0 turns it off)
    gridBright = 35: texOp = 100: wireOp = 100: BIN_W = BIN_MIN: PANEL_W = PANEL_MIN: picTS = 64
    ReadCfg

    FOR i = 1 TO _COMMANDCOUNT
        a$ = COMMAND$(i)
        SELECT CASE LCASE$(a$)
            CASE "--open": i = i + 1: argOpen$ = COMMAND$(i)
            CASE "--export": argExport = -1
            CASE "--drop": i = i + 1: dropFile$ = COMMAND$(i): dropWait = 90 ' (as if dropped on the window, where the pointer is 90 frames on: tests)
            CASE "--save": argSave = -1 ' (saved as it's opened: an imported prop as a .bld)
            CASE "--tidy": tidyView = -1 ' (the view tidied, as T)
            CASE "--shot": i = i + 1: argShot$ = COMMAND$(i)
            CASE "--quit": argQuit = -1
            CASE "--bench": i = i + 1: argBench = VAL(COMMAND$(i)) ' (the model made N times: bench.txt says how long)
            CASE "--neon": i = i + 1: neonDir$ = COMMAND$(i)
            CASE ELSE
                k$ = LCASE$(RIGHT$(a$, 4))
                IF k$ = ".bld" OR k$ = ".obj" THEN argOpen$ = a$
        END SELECT
    NEXT
    IF LEN(neonDir$) AND RIGHT$(neonDir$, 1) <> "/" THEN neonDir$ = neonDir$ + "/"
    WinStart ' (our screen, laid out)

    PartsSetup
    ViewSetup
    BinSetup
    IF LEN(argOpen$) THEN
        ModelLoad argOpen$ ' (its message says how it went)
        IF argBench > 0 THEN Bench argBench
    ELSE
        ModelNew
        Msg "Pick a shape on the left (or 1-6), click on the grid to put it down. H: every key"
    END IF
END SUB

' The model made into triangles n times: the time each took, in bench.txt
SUB Bench (n)
    DIM i, t0#, fh
    t0# = TIMER(.001)
    FOR i = 1 TO n: meshKey$ = "": MeshBuild: NEXT
    fh = FREEFILE: OPEN appDir$ + "bench.txt" FOR OUTPUT AS #fh
    PRINT #fh, "build ms"; (TIMER(.001) - t0#) * 1000 / n; " triangles"; sceneTN; " holes"; holeTN - sceneTN
    CLOSE #fh
END SUB

' bu1ld0r.cfg, beside the program: key=value lines
SUB ReadCfg
    DIM fh, l$, k$, v$, j
    IF NOT _FILEEXISTS(appDir$ + "bu1ld0r.cfg") THEN EXIT SUB
    fh = FREEFILE: OPEN appDir$ + "bu1ld0r.cfg" FOR INPUT AS #fh
    DO WHILE NOT EOF(fh)
        LINE INPUT #fh, l$
        l$ = LTRIM$(RTRIM$(l$)): j = INSTR(l$, "=")
        IF j > 0 AND LEFT$(l$, 1) <> "#" AND LEFT$(l$, 1) <> "'" THEN
            k$ = LCASE$(RTRIM$(LEFT$(l$, j - 1))): v$ = LTRIM$(MID$(l$, j + 1))
            SELECT CASE k$
                CASE "neon_dir": neonDir$ = v$
                CASE "neon_in": neonIn$ = v$
                CASE "draw": cfgDraw$ = v$
                CASE "kaleidotron": cfgKaleido$ = v$
                CASE "pic_dir": binPicDir$ = v$
                CASE "pic_size": picTS = INT(Clamp(VAL(v$), PIC_TS_MIN, PIC_TS_MAX))
                CASE "pic_outside": binPicExt$ = v$
                CASE "window" ' (WxH)
                    j = INSTR(LCASE$(v$), "x")
                    IF j THEN cfgWinW = VAL(LEFT$(v$, j - 1)): cfgWinH = VAL(MID$(v$, j + 1))
                    IF cfgWinW < 64 OR cfgWinH < 40 THEN cfgWinW = 0: cfgWinH = 0
                CASE "ui_scale": cfgUiK = INT(Clamp(VAL(v$), 0, 4))
                CASE "parts_list": listOn = (VAL(v$) <> 0)
                CASE "grid_walls": gridWalls = (VAL(v$) <> 0)
                CASE "bin_w": BIN_W = INT(VAL(v$)): IF BIN_W < BIN_MIN THEN BIN_W = BIN_MIN
                CASE "tex_on": viewWire = (VAL(v$) = 0)
                CASE "wire_on": wireOn = (VAL(v$) <> 0)
                CASE "tex_op": texOp = INT(Clamp(VAL(v$), 0, 100))
                CASE "wire_op": wireOp = INT(Clamp(VAL(v$), 0, 100))
                CASE "grid_bright": gridBright = VAL(v$): IF gridBright < 0 OR gridBright > 100 THEN gridBright = 35
            END SELECT
        END IF
    LOOP
    CLOSE #fh
END SUB

' The mouse's queue read out: where it ended, what was pressed and let go
SUB InputFrame
    DIM b1, b2, b3
    mP1 = 0: mP2 = 0: mP3 = 0: mR1 = 0: mR2 = 0: mR3 = 0: mWheel = 0
    DO WHILE _MOUSEINPUT
        mWheel = mWheel + _MOUSEWHEEL
        b1 = _MOUSEBUTTON(1): b2 = _MOUSEBUTTON(2): b3 = _MOUSEBUTTON(3)
        IF b1 AND NOT mB1 THEN mP1 = -1
        IF mB1 AND NOT b1 THEN mR1 = -1
        IF b2 AND NOT mB2 THEN mP2 = -1
        IF mB2 AND NOT b2 THEN mR2 = -1
        IF b3 AND NOT mB3 THEN mP3 = -1
        IF mB3 AND NOT b3 THEN mR3 = -1
        mB1 = b1: mB2 = b2: mB3 = b3
        IF mP1 OR mP2 OR mP3 THEN mX = INT(_MOUSEX / uiK): mY = INT(_MOUSEY / uiK): EXIT DO ' (a press is handled where it happened)
    LOOP
    mX = INT(_MOUSEX / uiK): mY = INT(_MOUSEY / uiK) ' (our screen's pixels: the window's are uiK times smaller)
    kShift = _KEYDOWN(100304) OR _KEYDOWN(100303)
    kCtrl = _KEYDOWN(100306) OR _KEYDOWN(100305)
    kAlt = _KEYDOWN(100308) OR _KEYDOWN(100307)
END SUB

' bu1ld0r.cfg's k$= line set to v$ (the rest of the file kept as it is)
SUB CfgSet (k$, v$)
    DIM fh, l$, t$, done, j, nl$, kk$
    nl$ = CHR$(10)
    IF _FILEEXISTS(appDir$ + "bu1ld0r.cfg") THEN
        fh = FREEFILE: OPEN appDir$ + "bu1ld0r.cfg" FOR INPUT AS #fh
        DO WHILE NOT EOF(fh)
            LINE INPUT #fh, l$
            j = INSTR(l$, "="): kk$ = ""
            IF j > 0 AND LEFT$(LTRIM$(l$), 1) <> "#" THEN kk$ = LCASE$(LTRIM$(RTRIM$(LEFT$(l$, j - 1))))
            IF kk$ = k$ THEN
                IF done = 0 THEN t$ = t$ + k$ + "=" + v$ + nl$: done = -1
            ELSE
                t$ = t$ + l$ + nl$
            END IF
        LOOP
        CLOSE #fh
    END IF
    IF done = 0 THEN t$ = t$ + k$ + "=" + v$ + nl$
    fh = FREEFILE: OPEN appDir$ + "bu1ld0r.cfg" FOR OUTPUT AS #fh: PRINT #fh, t$;: CLOSE #fh
END SUB

' ---------------------------------------------------------------- the window

' The UI scale that suits this display: the biggest that still leaves our
' screen roomy (1200 x 760 or more, in 9/10 of the display)
FUNCTION UiKAuto
    DIM k
    IF _DESKTOPWIDTH < 1 THEN UiKAuto = 1: EXIT FUNCTION
    FOR k = 4 TO 2 STEP -1
        IF _DESKTOPWIDTH * .9 / k >= 1200 AND _DESKTOPHEIGHT * .9 / k >= 760 THEN EXIT FOR
    NEXT
    UiKAuto = k
END FUNCTION

' Start-up: the window as it was left (or 9/10 of the display), at the UI scale set (or the one that suits)
SUB WinStart
    DIM w, h
    uiK = cfgUiK: IF uiK < 1 THEN uiK = UiKAuto
    IF cfgWinW > 0 THEN
        w = cfgWinW: h = cfgWinH
    ELSE
        w = INT(_DESKTOPWIDTH * .9): h = INT(_DESKTOPHEIGHT * .9)
        IF w < 1 THEN w = 1280: h = 800
    END IF
    ScreenSet w \ uiK, h \ uiK
    _ACCEPTFILEDROP ' (a PNG dropped on the window goes on the face it lands on: UI/PICS)
END SUB

' Our screen made sw x sh (even, no smaller than MIN_SW x MIN_SH, and no
' bigger than the display holds at uiK) - everything laid out on it again -
' and the window's SCREEN made uiK times that (which sizes the window)
SUB ScreenSet (sw0, sh0)
    DIM sw, sh, mw, mh, img&
    sw = sw0: sh = sh0
    IF _DESKTOPWIDTH > 0 AND _FULLSCREEN = 0 THEN
        mw = _DESKTOPWIDTH \ uiK: mh = (_DESKTOPHEIGHT - 60) \ uiK
        IF sw > mw THEN sw = mw
        IF sh > mh THEN sh = mh
    END IF
    IF sw < MIN_SW THEN sw = MIN_SW
    IF sh < MIN_SH THEN sh = MIN_SH
    sw = (sw \ 2) * 2: sh = (sh \ 2) * 2
    IF sw <> scrW OR sh <> scrH OR uiImg& = 0 THEN
        img& = _NEWIMAGE(sw, sh, 32)
        IF uiImg& < -1 THEN _FREEIMAGE uiImg&
        uiImg& = img&: scrW = sw: scrH = sh
        _DEST uiImg&: _SOURCE uiImg&
        _PRINTMODE _KEEPBACKGROUND
        Layout
    END IF
    IF sw * uiK <> winW OR sh * uiK <> winH OR winImg& = 0 THEN
        winW = sw * uiK: winH = sh * uiK
        img& = _NEWIMAGE(winW, winH, 32)
        SCREEN img&
        IF winImg& < -1 THEN _FREEIMAGE winImg&
        winImg& = img&
        _DEST uiImg&: _SOURCE uiImg& ' (SCREEN makes the new one the place to draw: ours again)
    END IF
END SUB

' The frame shown: our screen, uiK times bigger, by the graphics card
SUB Present
    DIM hw&
    hw& = _COPYIMAGE(uiImg&, 33)
    _PUTIMAGE (0, 0)-(winW - 1, winH - 1), hw&
    _DISPLAY
    IF presHw& < -1 THEN _FREEIMAGE presHw&
    presHw& = hw&
END SUB

' Where everything goes on our screen, and the 3D view's pictures made at its size
SUB Layout
    DockClamp
    vX0 = BIN_W - LIST_W * (listOn <> 0): vY0 = TOP_H: vW = scrW - vX0 - PANEL_W: vH = scrH - TOP_H - BAR_H
    IF viewImg& < -1 THEN _FREEIMAGE viewImg&
    IF ovImg& < -1 THEN _FREEIMAGE ovImg&
    viewImg& = _NEWIMAGE(vW, vH, 32): ovImg& = _NEWIMAGE(vW, vH, 32)
    RCap vW * vH
    viewDirty = -1: ovDirty = -1
    binTop = Clamp(binTop, 0, BinMaxTop)
END SUB

' The bin no narrower than it was made, nor so wide the view's under 240 (the panel stays as it is)
SUB DockClamp
    DIM room
    room = scrW - 240 - LIST_W * -(listOn <> 0)
    IF BIN_W > room - PANEL_W THEN BIN_W = room - PANEL_W
    IF BIN_W < BIN_MIN THEN BIN_W = BIN_MIN
END SUB

' 1 if the pointer's on the bin's edge (dragged wider or narrower), else 0
FUNCTION DockAt (x, y)
    IF y < TOP_H OR y >= scrH - BAR_H THEN EXIT FUNCTION
    IF x >= BIN_W - 4 AND x <= BIN_W + 1 THEN DockAt = 1
END FUNCTION

' Each frame: an edge dragged (laid out again as it goes; let go: remembered), the pointer a <-> over one
SUB DockFrame
    DIM w, c
    IF dockDrag THEN
        w = BIN_W
        BIN_W = mX + 1
        DockClamp
        IF BIN_W <> w THEN Layout
        IF NOT mB1 THEN
            CfgSet "bin_w", LTRIM$(STR$(BIN_W))
            dockDrag = 0
        END IF
    END IF
    c = (dockDrag <> 0 OR DockAt(mX, mY) <> 0)
    IF c <> dockCur THEN
        dockCur = c
        IF c THEN _MOUSESHOW "HORIZONTAL" ELSE _MOUSESHOW "DEFAULT"
    END IF
END SUB

' Once a frame: a window dragged to a size of its own, once it's been let
' go a moment, gets our screen laid out again at its size / uiK (and is
' remembered); going full screen (F11, or QB64PE's Alt+Enter) lays it out
' on the whole display, and coming back puts the window back as it was
SUB WindowFrame
    STATIC pend, pendAt AS DOUBLE, pw, ph, fullWas
    DIM rw, rh, f
    IF _RESIZE THEN
        rw = _RESIZEWIDTH: rh = _RESIZEHEIGHT
        IF rw <> winW OR rh <> winH THEN pw = rw: ph = rh: pend = -1: pendAt = TIMER(0.001) ' (dragged - not our own size arriving)
    END IF
    f = _FULLSCREEN
    IF f <> fullWas THEN
        fullWas = f: pend = 0
        IF f THEN
            preFullW = scrW: preFullH = scrH
            ScreenSet _DESKTOPWIDTH \ uiK, _DESKTOPHEIGHT \ uiK
        ELSEIF preFullW > 0 THEN
            ScreenSet preFullW, preFullH
        END IF
        EXIT SUB
    END IF
    IF f THEN pend = 0: EXIT SUB
    IF pend AND ABS(TIMER(0.001) - pendAt) > .15 THEN
        pend = 0
        IF pw < 1 OR ph < 1 THEN EXIT SUB
        ScreenSet pw \ uiK, ph \ uiK
        WinRemember
    END IF
END SUB

SUB WinRemember
    IF winW = cfgWinW AND winH = cfgWinH THEN EXIT SUB
    cfgWinW = winW: cfgWinH = winH
    CfgSet "window", LTRIM$(STR$(winW)) + "x" + LTRIM$(STR$(winH))
END SUB

' Ctrl + / Ctrl -: the UI bigger or smaller (the window keeps its size, if it can)
SUB UiScaleStep (d)
    DIM k, w, h
    IF _FULLSCREEN THEN Msg "The UI's size changes in a window (F11: back to one)": EXIT SUB
    k = uiK + d
    IF k < 1 OR k > 4 THEN EXIT SUB
    IF _DESKTOPWIDTH > 0 THEN
        IF MIN_SW * k > _DESKTOPWIDTH OR MIN_SH * k > _DESKTOPHEIGHT - 60 THEN Msg "The UI can't be bigger on this display": EXIT SUB
    END IF
    w = winW: h = winH
    uiK = k: ScreenSet w \ uiK, h \ uiK
    WinRemember
    cfgUiK = uiK: CfgSet "ui_scale", LTRIM$(STR$(uiK))
    Msg "UI scale" + STR$(uiK) + "x (Ctrl+ and Ctrl- change it): the screen is" + STR$(scrW) + " x" + STR$(scrH)
END SUB

' F11: full screen or back
SUB FullToggle
    IF _FULLSCREEN THEN _FULLSCREEN _OFF ELSE _FULLSCREEN _SQUAREPIXELS
END SUB

SUB Msg (t$)
    msgText$ = t$: msgT = TIMER(0.001)
END SUB

' l$ split at spaces into wd$(1 to wdN)
SUB Words (l$)
    DIM p, j, n
    n = 0: p = 1
    DO
        DO WHILE MID$(l$, p, 1) = " " OR MID$(l$, p, 1) = CHR$(9): p = p + 1: LOOP
        IF p > LEN(l$) OR n >= 1000 THEN EXIT DO
        j = p
        DO WHILE j <= LEN(l$) AND MID$(l$, j, 1) <> " " AND MID$(l$, j, 1) <> CHR$(9): j = j + 1: LOOP
        n = n + 1: wd$(n) = MID$(l$, p, j - p): p = j
    LOOP
    wdN = n
END SUB

' A number as a file or field shows it: up to 4 decimals, no trailing zeros, 0.5 not .5
FUNCTION Fmt$ (v)
    DIM n AS LONG, s$, w$, f$
    n = CLNG(v * 10000)
    IF n < 0 THEN s$ = "-": n = -n
    w$ = LTRIM$(STR$(n \ 10000)): f$ = RIGHT$("000" + LTRIM$(STR$(n MOD 10000)), 4)
    DO WHILE RIGHT$(f$, 1) = "0" AND LEN(f$): f$ = LEFT$(f$, LEN(f$) - 1): LOOP
    IF LEN(f$) THEN f$ = s$ + w$ + "." + f$ ELSE f$ = s$ + w$
    IF f$ = "-0" THEN f$ = "0"
    Fmt$ = f$
END FUNCTION

FUNCTION HexCol$ (c AS _UNSIGNED LONG)
    HexCol$ = RIGHT$("00000" + HEX$(c AND &HFFFFFF), 6)
END FUNCTION

' "RRGGBB" (a # or not) as a colour; ok = 0 if it wasn't one
FUNCTION ParseCol~& (t$, ok)
    DIM s$, i
    s$ = UCASE$(LTRIM$(RTRIM$(t$))): IF LEFT$(s$, 1) = "#" THEN s$ = MID$(s$, 2)
    ok = 0
    IF LEN(s$) <> 6 THEN EXIT FUNCTION
    FOR i = 1 TO 6
        IF INSTR("0123456789ABCDEF", MID$(s$, i, 1)) = 0 THEN EXIT FUNCTION
    NEXT
    ok = -1
    ParseCol~& = _RGB32(VAL("&H" + MID$(s$, 1, 2)), VAL("&H" + MID$(s$, 3, 2)), VAL("&H" + MID$(s$, 5, 2)))
END FUNCTION

FUNCTION Clamp (v, lo, hi)
    Clamp = v
    IF v < lo THEN Clamp = lo
    IF v > hi THEN Clamp = hi
END FUNCTION

FUNCTION InRect (x, y, x0, y0, w, h)
    InRect = (x >= x0 AND x < x0 + w AND y >= y0 AND y < y0 + h)
END FUNCTION

SUB Txt (x, y, t$, c AS _UNSIGNED LONG)
    COLOR c: _PRINTSTRING (x, y), t$
END SUB

' A button: its box, lit when the pointer's over it (or on), its words in the middle
SUB Btn (x, y, w, h, t$, onIt)
    DIM c AS _UNSIGNED LONG
    c = cBtn: IF InRect(mX, mY, x, y, w, h) THEN c = cHover
    IF onIt THEN c = _RGB32(90, 30, 110)
    LINE (x, y)-(x + w - 1, y + h - 1), c, BF
    LINE (x, y)-(x + w - 1, y + h - 1), cLine, B
    Txt x + (w - 8 * LEN(t$)) \ 2, y + (h - 16) \ 2, t$, cText
END SUB

' A button pressed this frame (the left button went down on it)
FUNCTION BtnHit (x, y, w, h)
    BtnHit = mP1 AND InRect(mX, mY, x, y, w, h)
END FUNCTION

FUNCTION DSin (d)
    DSin = SIN(d * 3.14159265 / 180)
END FUNCTION

FUNCTION DCos (d)
    DCos = COS(d * 3.14159265 / 180)
END FUNCTION
